    ∫ ωs : κ → ι, ‖X ωs - empiricalMean Y‖ ^ 2 ∂Pκ =
        ∫ ωs : κ → ι, ‖X ωs - ∫ ωs, X ωs ∂Pκ‖ ^ 2 ∂Pκ := by
          rw [hmean]
    _ = Matrix.trace (covMat Pκ (fun ωs a => X ωs a)) := by
          exact integral_norm_sq_sub_mean_eq_trace_covMat_euclidean_of_finite
