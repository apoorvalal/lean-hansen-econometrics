/-- Indexed Theorem 10.12 zero-mean covariance specialization. -/
theorem chapter10_indexed_trimmedBootstrapVariance_tendsto
    {k : Type*} [Fintype k]
    {Ωboot : ℕ → Type*} [∀ n, MeasurableSpace (Ωboot n)]
