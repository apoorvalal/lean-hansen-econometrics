  classical
  let Pκ : Measure (κ → ι) :=
    ProbabilityTheory.uniformOn (Set.univ : Set (κ → ι))
  let X : (κ → ι) → EuclideanSpace ℝ k :=
    fun ωs => empiricalBootstrapResampleMean Y (fun ωs t => ωs t) ωs
