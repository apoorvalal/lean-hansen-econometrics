    (hZstar : ∀ n ω, Measurable (Zstar n ω))
    (hZstar' : ∀ n ω, Measurable (Zstar' n ω))
    (hZstar_mem : ∀ n ω ωs, Zstar n ω ωs ∈ K)
    (hZstar'_mem : ∀ n ω ωs, Zstar' n ω ωs ∈ K)
    (hclose : ∀ δ : ℝ, 0 < δ →
      TendstoInMeasure μ
        (fun n ω =>
          (Pstar n ω).real {ωs | δ ≤ dist (Zstar' n ω ωs) (Zstar n ω ωs)})
