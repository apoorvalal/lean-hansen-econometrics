    fun t ωs => c • (Y (ωs t) - empiricalMean Y)
  let G : ι → ℝ := fun i => c • (Y i - empiricalMean Y)
  have hIndep : iIndepFun X Pκ := by
    simpa [X, Pκ] using
      (iIndepFun_uniformOn_fun_eval_smul_sub_empiricalMean
        (κ := κ) (ι := ι) (E := ℝ) c Y)
