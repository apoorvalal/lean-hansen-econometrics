        (((ProbabilityTheory.uniformOn (Set.univ : Set ι) : Measure ι).map
          (fun i => c • (Y i - empiricalMean Y)))) u) ^ Fintype.card κ := hpow
    _ =
      (charFun
        (((ProbabilityTheory.uniformOn (Set.univ : Set ι) : Measure ι).map
          (fun i => Y i - empiricalMean Y)))
        ((Real.sqrt (Fintype.card κ : ℝ))⁻¹ * u)) ^ Fintype.card κ := by
        rw [hscale]

