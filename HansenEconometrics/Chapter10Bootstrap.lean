        (hIndep.indepFun_mul_right hMeas a b c hab hac).integral_mul_eq_mul_integral
          (hAEStrong a) ((hAEStrong b).mul (hAEStrong c))
      have hz :
          ∫ ωs, X a ωs * X b ωs * X c ωs ∂Pκ = 0 := by
        calc
