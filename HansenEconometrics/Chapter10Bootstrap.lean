    [Fintype k] [IsFiniteMeasure ν]
    {Pstar : ℕ → Ω → Measure Ωs} {Zstar : ℕ → Ω → Ωs → k → ℝ}
    {Z : Ωlim → k → ℝ}
    {Ccoord : k → ℝ} {Csum : k → k → ℝ}
