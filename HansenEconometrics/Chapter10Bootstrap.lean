    chapter10_finiteReplicationVariance_tendsto_of_smooth_linearization_normFourthMoment
    {d r : Type*} [Fintype d] [Fintype r] [DecidableEq d] [DecidableEq r]
    {Zsim : ℕ → ℕ → Ω → ℝ}
    {Pstar : ℕ → Ω → Measure Ωs}
