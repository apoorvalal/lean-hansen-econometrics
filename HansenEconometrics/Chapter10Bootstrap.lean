                        congr with ωs
                        ring
                  _ = 0 := hsingleton c a b d hc.1 hc.2.1 hc.2.2
              · change ∫ ωs, X a ωs * X b ωs * X c ωs * X d ωs ∂Pκ = 0
                calc
                  ∫ ωs, X a ωs * X b ωs * X c ωs * X d ωs ∂Pκ =
                      ∫ ωs, X d ωs * X a ωs * X b ωs * X c ωs ∂Pκ := by
                        congr with ωs
                        ring
                  _ = 0 := hsingleton d a b c hd.1 hd.2.1 hd.2.2

