    charFun
        (((ProbabilityTheory.uniformOn (Set.univ : Set (κ → ι)) :
          Measure (κ → ι)).map
          (fun ωs =>
            Real.sqrt (Fintype.card κ : ℝ) *
              (empiricalBootstrapResampleMean Y (fun ωs t => ωs t) ωs -
