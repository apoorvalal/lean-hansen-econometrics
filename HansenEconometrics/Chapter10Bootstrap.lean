    calc
      ∫ ωs, X p ωs * X p ωs * X q ωs * X q ωs ∂Pκ =
          ∫ ωs, (X p * X p) ωs * (X q * X q) ωs ∂Pκ := by
            congr with ωs
            simp [Pi.mul_apply]
            ring
      _ = (∫ ωs, (X p * X p) ωs ∂Pκ) *
            ∫ ωs, (X q * X q) ωs ∂Pκ := hmul
      _ = empiricalCumulant2 Y ^ 2 := by
            change
