    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (Y : ι → E) :
    ∫ ωs : κ → ι,
        Real.sqrt (Fintype.card κ : ℝ) •
          (empiricalBootstrapResampleMean Y (fun ωs t => ωs t) ωs - empiricalMean Y)
