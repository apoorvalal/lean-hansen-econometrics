    (Real.sqrt_pos.2 hcard_pos).ne'
  have hsqrt_sq :
      Real.sqrt (Fintype.card κ : ℝ) ^ 2 = (Fintype.card κ : ℝ) :=
    Real.sq_sqrt hcard_pos.le
