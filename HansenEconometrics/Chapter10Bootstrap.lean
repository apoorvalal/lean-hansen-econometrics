          exact (hcnone hc).elim
      rw [hc]
      exact sum_finset_ne_eq_card_sub_one_mul s a ha x
    · intro b hb hba
      have hab : a ≠ b := fun h => hba h.symm
      simp [hab]
    · intro hanone
      exact (hanone ha).elim
  calc
    (∑ a ∈ s, ∑ b ∈ s, ∑ c ∈ s, ∑ d ∈ s,
        if a = b ∧ c = d ∧ a ≠ c then x else 0) =
        ∑ a ∈ s, ((s.card : ℝ) - 1) * x := by
          apply Finset.sum_congr rfl
          intro a ha
          exact hinner a ha
    _ = (s.card : ℝ) * ((s.card : ℝ) - 1) * x := by
          simp [mul_assoc]

