        atTop (𝓝 0)) :
    Tendsto
      (fun n : ℕ =>
        (n : ℝ) *
          (randomCoverage n -
            coverage -
            (n : ℝ)⁻¹ * (2 * (p2 c * density c))))
      atTop (𝓝 0) :=
  chapter10_percentileT_secondOrder_interval_transfer
    (fixedCoverage := fun n : ℕ =>
      statisticCDFReal μ T n c - statisticCDFReal μ T n (-c))
