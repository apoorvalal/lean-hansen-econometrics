    subst b
    subst c
    subst d
    change ∫ ωs, X a ωs * X a ωs * X a ωs * X a ωs ∂Pκ =
      empiricalCentralMoment Y 4
    calc
      ∫ ωs, X a ωs * X a ωs * X a ωs * X a ωs ∂Pκ =
          ∫ ωs, X a ωs ^ 4 ∂Pκ := by
            congr with ωs
            ring
