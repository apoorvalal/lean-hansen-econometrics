    (hZmeas : ∀ n ω, Measurable (Zstar n ω))
    (hZmem : ∀ n ω, MemLp (Zstar n ω) 2 (Pstar n ω))
    (hτpos : ∀ n, 0 < τ n)
    (hτinv : Tendsto (fun n => ((τ n) ^ 2)⁻¹) atTop (𝓝 0))
    (hSecond :
      TendstoInMeasure μ
        (fun n ω => ∫ ωs, ‖Zstar n ω ωs‖ ^ 2 ∂Pstar n ω)
