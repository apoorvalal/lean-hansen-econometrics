  have hPfinite : ∀ n ω, IsFiniteMeasure (Pstar n ω) := by
    intro n ω
    letI : IsProbabilityMeasure (Pstar n ω) := hPstar n ω
    infer_instance
  have hZstar :
      ∀ n ω,
        Measurable
          (fun ωs => fun _ : Unit => |Xstar n ω ωs / Ystar n ω ωs|) := by
    intro n ω
