    (hleft : ∀ ξ,
      IsUnit
        (((Matrix.fromCols (X₁ ξ)
            (expectationErrorFittedStar
              (Matrix.fromCols (X₁ ξ) (Z₂ ξ)) (X₂ ξ)))ᵀ *
