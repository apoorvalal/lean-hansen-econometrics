theorem
    controlFunctionFTest_theorem12_15_conditionalNormal_lowerTail_of_includedInstrumentProjectionSpanBlockRanks_rawConditionalNormal
    {κ ι l₂ : Type*} [MeasurableSpace κ] [MeasurableSpace ι]
    [Fintype l₂] [DecidableEq l₂]
