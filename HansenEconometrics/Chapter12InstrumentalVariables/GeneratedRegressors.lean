  intro ξ
  letI := hInvRestricted ξ
  letI := hInvFull ξ
  exact generatedRegressorFStatistic_hasLaw_classicalFDist_card_sub
    (μ := με ξ) (W₁ := W₁ ξ) (W₂hat := W₂hat ξ)
