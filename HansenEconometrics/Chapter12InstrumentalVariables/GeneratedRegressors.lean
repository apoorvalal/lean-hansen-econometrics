    intro r
    exact sampleGram_from_matrix_aestronglyMeasurable (μ := μ)
      (controlFunctionExpectationErrorDesignStar_aestronglyMeasurable_of_rows
        (μ := μ) (N := r) hX₁ hX₂ hZ)
