    (hβ₁ : ∀ j, Measurable fun ξ => β₁ ξ j) :
    (π.prod με).real {p : ι × Ωε | c <
      letI : Invertible ((W₁ p.1)ᵀ * W₁ p.1) :=
        Matrix.invertibleOfIsUnitDet
          (A := (W₁ p.1)ᵀ * W₁ p.1)
