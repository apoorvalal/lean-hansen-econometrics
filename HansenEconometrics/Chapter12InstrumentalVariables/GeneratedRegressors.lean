      (fun _ => popGram μ X) :=
    sampleGram_stackRegressors_tendstoInMeasure_popGram_of_wlln hXGramPkg
  have hBMeas : ∀ m, AEStronglyMeasurable (B m) μ := by
    intro m
    have hInv := aestronglyMeasurable_matrix_inv (hMom.qzz_meas m)
    have hLeft :=
