    (G : Ωlim → EuclideanSpace ℝ (Sum k₁ k₂)) :
    Ωlim → EuclideanSpace ℝ k₂ :=
  fun ω => WithLp.toLp 2 (generatedRegressorRightBlock (G ω).ofLp)

