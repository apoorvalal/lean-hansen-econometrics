            simp [Matrix.mul_sub, Matrix.mul_assoc]
    _ = Zᵀ * X₂ - ((Zᵀ * Z) * (Zᵀ * Z)⁻¹) * (Zᵀ * X₂) := by
            simp [Matrix.mul_assoc]
    _ = Zᵀ * X₂ - Zᵀ * X₂ := by
