                (stackRegressors Z m ω))ᵀ *
              controlFunctionDesignStar
                (stackRegressors X₁ m ω) (stackRegressors X₂ m ω)
                (stackRegressors Z m ω)) hcf_unit
        letI : Invertible
            ((controlFunctionExpectationErrorDesignStar
              (stackRegressors X₁ m ω) (stackRegressors X₂ m ω)
              (stackRegressors Z m ω))ᵀ *
            controlFunctionExpectationErrorDesignStar
              (stackRegressors X₁ m ω) (stackRegressors X₂ m ω)
