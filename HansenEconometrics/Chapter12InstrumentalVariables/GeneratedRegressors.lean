              (X₂ := stackRegressors X₂ m ω)
              (Z := stackRegressors Z m ω)
              (Y := stackOutcomes Y m ω)
        have hzero : Vactual m ω - Vfrom m ω = 0 := by
          simp [hbridge]
        change ε ≤ edist (Vactual m ω - Vfrom m ω) 0 at hω
        rw [hzero, edist_self] at hω
        exact (not_le_of_gt hε) hω
