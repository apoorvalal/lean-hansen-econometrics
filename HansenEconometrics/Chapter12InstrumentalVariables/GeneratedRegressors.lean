  have hLaw : HasLaw T
      (classicalFDist (Fintype.card k₂)
        (Fintype.card n - Fintype.card k₁ - 2 * Fintype.card k₂))
      (π.prod με) :=
    controlFunctionEndogeneityFStatistic_randomDesign_hasLaw_classicalFDist_card_sub
