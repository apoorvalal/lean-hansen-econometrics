    simpa [h.alpha_null] using h.alpha_limit
  simpa [controlFunctionEndogeneityWaldStatOrZero] using
    restrictionWaldStatOrZero_tendstoInDistribution_chiSquared
      (μ := μ) (ν := ν) (r := r)
      (T := fun (m : ℕ) ω =>
        root m •
