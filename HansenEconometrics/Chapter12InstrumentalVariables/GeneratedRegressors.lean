theorem controlFunctionAlphaVHatStar_tendstoInMeasure_of_expectationError_nonsingular_in_probability
    {X₁ : ℕ → Ω → k₁ → ℝ} {X₂ : ℕ → Ω → k₂ → ℝ}
    {Z : ℕ → Ω → l → ℝ} {Y : ℕ → Ω → ℝ}
