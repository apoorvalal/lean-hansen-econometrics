      (fun ω =>
        generatedRegressorBetaStar
          (fun i : Fin N => Z i.val ω) (Ahat ω)
          (fun i : Fin N => Y i.val ω)) μ := by
  let Wmat : Ω → Matrix (Fin N) k ℝ := fun ω =>
    generatedRegressors (fun i : Fin N => Z i.val ω) (Ahat ω)
