    (A : Matrix l (Sum k₁ k₂) ℝ) (β : Sum k₁ k₂ → ℝ) :
    Measurable (fun p : (l → ℝ) × ℝ =>
      (Aᵀ *ᵥ p.1, p.2 - (Aᵀ *ᵥ p.1) ⬝ᵥ β)) := by
