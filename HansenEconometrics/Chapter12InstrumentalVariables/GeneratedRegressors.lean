private theorem scoreOuter_integrable
    {Z : ℕ → Ω → l → ℝ} {v : ℕ → Ω → ℝ}
    (hv4 : MemLp (v 0) 4 μ)
    (hZ4 : ∀ a : l, MemLp (fun ω => Z 0 ω a) 4 μ) :
    Integrable (fun ω =>
      Matrix.vecMulVec (v 0 ω • Z 0 ω) (v 0 ω • Z 0 ω)) μ := by
