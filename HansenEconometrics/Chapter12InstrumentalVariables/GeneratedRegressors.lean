      (stackRegressors Z m ω) (stackOutcomes Y m ω)
  let Vlim : Matrix k₂ k₂ ℝ :=
    controlFunctionEndogeneityMap * V * (controlFunctionEndogeneityMap)ᵀ
  have hfrom_meas : ∀ m, AEStronglyMeasurable (Vfrom m) μ := by
