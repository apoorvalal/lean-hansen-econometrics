    exact TendstoInMeasure.mul_boundedInProbability
      hdiff (hX a)
  simpa [Matrix.mulVec, dotProduct] using
    tendstoInMeasure_finset_sum_zero_real
      (s := (Finset.univ : Finset l)) (X := fun a m ω =>
