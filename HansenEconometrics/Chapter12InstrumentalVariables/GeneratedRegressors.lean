    {Z : ℕ → Ω → l → ℝ} {X : ℕ → Ω → k → ℝ} {Y : ℕ → Ω → ℝ}
    {A : Matrix l k ℝ} {QZZ OmegaZE : Matrix l l ℝ}
    {β : k → ℝ} {G : Ωlim → EuclideanSpace ℝ k}
    (h : GeneratedRegressorLSAsymptoticNormalConditions
