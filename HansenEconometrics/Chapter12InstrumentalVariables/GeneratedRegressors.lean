  let Vfrom : ℕ → Ω → Matrix k₂ k₂ ℝ := fun m ω =>
    controlFunctionAlphaVHatFromExpectationErrorStar
      (stackRegressors X₁ m ω) (stackRegressors X₂ m ω)
