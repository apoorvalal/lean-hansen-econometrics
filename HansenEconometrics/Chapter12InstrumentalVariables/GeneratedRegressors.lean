private theorem
    generatedRegressorWaldDiv_randomDesign_exactSize_lowerTail_of_measurableDesign
    {ι Ωε : Type*} [MeasurableSpace ι] [MeasurableSpace Ωε]
    {π : Measure ι} {με : Measure Ωε}
