    { observed_aestronglyMeasurable := h.observed_aestronglyMeasurable
      observed_iIndep := h.observed_iIndep
      observed_identDistrib := h.observed_identDistrib
      model := ?_
      response_fourth_integrable := h.response_fourth_integrable
