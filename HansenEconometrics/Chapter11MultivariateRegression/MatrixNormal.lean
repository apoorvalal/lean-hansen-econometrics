/-- The sample mean of iid normal rows is jointly Gaussian. -/
theorem sampleMeanMatrix_hasGaussianLaw_of_iid_normal_rows
    [IsProbabilityMeasure μ]
    (Y : Ω → Matrix n m ℝ)
