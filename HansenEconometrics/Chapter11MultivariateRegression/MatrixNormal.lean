      Nonempty (Invertible (matrixCrossProduct (Rest Y))) :=
    (hRest.ae_iff
      (p := fun X : Matrix n r ℝ => Nonempty (Invertible (matrixCrossProduct X)))
      hp).2 (by simpa [Xlaw] using hgram)
  filter_upwards [hRestGram] with Y hY
  simpa [Rest, matrixCrossProduct] using hY

