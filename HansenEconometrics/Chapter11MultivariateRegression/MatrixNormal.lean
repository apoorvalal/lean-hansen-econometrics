/-- Coordinate mean of the row sample mean. -/
theorem sampleMeanMatrix_integral_eval
    [IsProbabilityMeasure μ] [Nonempty n]
    (Y : Ω → Matrix n m ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (a : m) :
    ∫ ω, sampleMeanMatrix (Y ω) a ∂μ = mean a := by
  classical
  let c : ℝ := (Fintype.card n : ℝ)⁻¹
  have hcard : (Fintype.card n : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hint : ∀ i : n, Integrable (fun ω => c * Y ω i a) μ := by
    intro i
    exact memLp_one_iff_integrable.mp
      (((iidNormalRows_memLp_eval
        (Y := Y) (mean := mean) (Sigma := Sigma) hrow i a).const_mul c).mono_exponent
          one_le_two)
  calc
    ∫ ω, sampleMeanMatrix (Y ω) a ∂μ
        = ∫ ω, c * ∑ i : n, Y ω i a ∂μ := by
            simp [sampleMeanMatrix, c, smul_eq_mul]
    _ = ∫ ω, ∑ i : n, c * Y ω i a ∂μ := by
            congr with ω
            rw [Finset.mul_sum]
    _ = ∑ i : n, ∫ ω, c * Y ω i a ∂μ := by
            rw [integral_finset_sum]
            intro i _
            exact hint i
    _ = ∑ _i : n, c * mean a := by
            refine Finset.sum_congr rfl ?_
            intro i _
            rw [integral_const_mul]
            have hmean_raw := (hrow i).integral_comp
              (f := fun x : m → ℝ => x a)
              ((measurable_pi_apply (X := fun _ : m => ℝ) a).aestronglyMeasurable)
            have hmean_i : ∫ ω, Y ω i a ∂μ = mean a := by
              simpa [Function.comp_def, rowGaussianLaw_integral_eval mean Sigma a] using hmean_raw
            rw [hmean_i]
    _ = mean a := by
            simp [c, Finset.sum_const, nsmul_eq_mul, hcard]

omit [DecidableEq n] in
/-- Coordinate covariance of the row sample mean.

This reuses Chapter 6's iid sample-mean covariance identity and specializes it
to the row-normal sampling law. -/
theorem sampleMeanMatrix_covariance_eval
    [IsProbabilityMeasure μ] [Nonempty n]
    (Y : Ω → Matrix n m ℝ)
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ)
    (a b : m) :
    cov[fun ω => sampleMeanMatrix (Y ω) a,
        fun ω => sampleMeanMatrix (Y ω) b; μ] =
      (Fintype.card n : ℝ)⁻¹ * Sigma a b := by
  classical
  let j : n := Classical.choice ‹Nonempty n›
  have hZ : ∀ i a, MemLp (fun ω => Y ω i a) 2 μ := by
    intro i a
    exact iidNormalRows_memLp_eval
      (Y := Y) (mean := mean) (Sigma := Sigma) hrow i a
  have hindep : ∀ a b, Pairwise (fun i l =>
      (fun ω => Y ω i a) ⟂ᵢ[μ] (fun ω => Y ω l b)) := by
    intro a b i l hil
    exact (hInd.indepFun hil).comp
      (measurable_pi_apply (X := fun _ : m => ℝ) a)
      (measurable_pi_apply (X := fun _ : m => ℝ) b)
  have hcov : ∀ i a b,
      cov[fun ω => Y ω i a, fun ω => Y ω i b; μ] =
        cov[fun ω => Y ω j a, fun ω => Y ω j b; μ] := by
    intro i a b
