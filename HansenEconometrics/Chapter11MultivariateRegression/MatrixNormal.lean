/-- Centered and `√n`-scaled sample mean from iid Gaussian rows.

This is the normal-law component used in Hansen Theorem 11.12 before applying
the Mahalanobis chi-square bridge. -/
theorem sampleMeanMatrix_centered_scaled_hasLaw_multivariateGaussian
    [IsProbabilityMeasure μ] [Nonempty n]
    (Y : Ω → Matrix n m ℝ)
    (μ0 : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosDef)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw μ0 Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ) :
    HasLaw (fun ω => WithLp.toLp 2
        (fun a : m => Real.sqrt (Fintype.card n : ℝ) *
          (sampleMeanMatrix (Y ω) a - μ0 a)))
      (multivariateGaussian 0 Sigma) μ := by
  classical
  let c : ℝ := Real.sqrt (Fintype.card n : ℝ)
  let B : Matrix m m ℝ := c • (1 : Matrix m m ℝ)
  let a0 : EuclideanSpace ℝ m := -c • WithLp.toLp 2 μ0
  have hnpos : 0 < (Fintype.card n : ℝ) := by
    exact_mod_cast Fintype.card_pos_iff.mpr ‹Nonempty n›
  have hc_sq : c * c = (Fintype.card n : ℝ) := by
    dsimp [c]
    rw [← pow_two]
    exact Real.sq_sqrt (le_of_lt hnpos)
  have hMeanLaw := sampleMeanMatrix_hasLaw_multivariateGaussian
    (Y := Y) (mean := μ0) (hSigma := hSigma.posSemidef) hrow hInd
  have hAff := hasLaw_affine_multivariateGaussian
    (P := μ) (hS := (hSigma.posSemidef.smul (inv_nonneg.mpr (by positivity))))
    hMeanLaw a0 B
  have hMeanZero :
      a0 + matrixContinuousLinearMap B (WithLp.toLp 2 μ0) = 0 := by
    ext j
    simp [a0, B, c, smul_mulVec, Matrix.one_mulVec]
  have hCovEq :
      B * ((Fintype.card n : ℝ)⁻¹ • Sigma) * Bᴴ = Sigma := by
    ext i j
    simp [B]
    calc
      c * ((Fintype.card n : ℝ)⁻¹ * (c * Sigma i j))
          = ((c * c) * (Fintype.card n : ℝ)⁻¹) * Sigma i j := by ring
      _ = ((Fintype.card n : ℝ) * (Fintype.card n : ℝ)⁻¹) * Sigma i j := by rw [hc_sq]
      _ = Sigma i j := by rw [mul_inv_cancel₀ (ne_of_gt hnpos), one_mul]
  rw [hMeanZero, hCovEq] at hAff
  refine hAff.congr ?_
  filter_upwards with ω
  ext j
  simp [a0, B, c, matrixContinuousLinearMap_apply, smul_mulVec,
    Matrix.one_mulVec, sub_eq_add_neg]
  ring

