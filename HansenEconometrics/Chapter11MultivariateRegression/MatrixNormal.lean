/-- The standard-coordinate Gram matrix as an explicit `1 + r` block matrix. -/
theorem matrixCrossProduct_standardCoordinate_eq_fromBlocks
    {r : Type*} [Fintype r]
    (Y : Matrix n (Sum Unit r) ℝ) :
    matrixCrossProduct Y =
      Matrix.fromBlocks
        (fun _ _ : Unit =>
          (standardCoordinateFirstColumn (n := n) Y : n → ℝ) ⬝ᵥ
            (standardCoordinateFirstColumn (n := n) Y : n → ℝ))
        (fun (_ : Unit) (j : r) =>
          (standardCoordinateFirstColumn (n := n) Y : n → ℝ) ⬝ᵥ
            fun i : n => standardCoordinateRestColumns (n := n) Y i j)
        (fun (j : r) (_ : Unit) =>
          (fun i : n => standardCoordinateRestColumns (n := n) Y i j) ⬝ᵥ
            (standardCoordinateFirstColumn (n := n) Y : n → ℝ))
        ((standardCoordinateRestColumns (n := n) Y)ᵀ *
          standardCoordinateRestColumns (n := n) Y) := by
  ext a b
  cases a with
  | inl u =>
      cases u
      cases b with
      | inl v =>
          cases v
          rw [matrixCrossProduct_standardCoordinate_inl_inl]
          rfl
      | inr j =>
          rw [matrixCrossProduct_standardCoordinate_inl_inr]
          rfl
  | inr j =>
      cases b with
      | inl v =>
          cases v
          simp [matrixCrossProduct, Matrix.mul_apply, dotProduct, mul_comm]
      | inr k =>
          rw [matrixCrossProduct_standardCoordinate_inr_inr]
          rfl

