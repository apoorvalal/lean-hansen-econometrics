        standardCoordinateRestColumns (n := n) Y)) := by
  classical
  let Ylaw : Measure (Matrix n (Sum Unit r) ℝ) :=
    iidMatrixGaussianLaw (n := n) (m := Sum Unit r)
      (0 : Sum Unit r → ℝ) (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ)
  let Xlaw : Measure (Matrix n r ℝ) :=
    iidMatrixGaussianLaw (n := n) (m := r)
      (0 : r → ℝ) (1 : Matrix r r ℝ)
