/-- The scalar Schur complement of the standard-coordinate Gram matrix equals
the quadratic form in the residual-maker for the nuisance columns.

This is the deterministic algebraic core of the standard-coordinate
Schur-complement step, before converting the top-left inverse block into the
inverse-Wishart scalar. -/
theorem standardCoordinate_schurComplement_eq_residualProjection
    {r : Type*} [Fintype r] [DecidableEq r]
    (Y : Matrix n (Sum Unit r) ℝ) :
    let z : n → ℝ := (standardCoordinateFirstColumn (n := n) Y : n → ℝ)
    let X : Matrix n r ℝ := standardCoordinateRestColumns (n := n) Y
    let A : Matrix Unit Unit ℝ := fun _ _ => z ⬝ᵥ z
    let B : Matrix Unit r ℝ := fun _ j => z ⬝ᵥ fun i : n => X i j
    let C : Matrix r Unit ℝ := fun j _ => (fun i : n => X i j) ⬝ᵥ z
    let D : Matrix r r ℝ := Xᵀ * X
    (A - B * D⁻¹ * C) () () =
      z ⬝ᵥ (gaussianResidualProjection (n := n) X *ᵥ z) := by
  classical
  intro z X A B C D
  have hblock :
      (B * D⁻¹ * C) () () =
        z ⬝ᵥ ((X * D⁻¹ * Xᵀ) *ᵥ z) := by
    have hB : (fun j : r => B () j) = z ᵥ* X := by
      ext j
      simp [B, Matrix.vecMul, dotProduct]
    have hC : (fun j : r => C j ()) = Xᵀ *ᵥ z := by
      ext j
      simp [C, Matrix.mulVec, dotProduct]
    calc
      (B * D⁻¹ * C) () ()
          = ((fun j : r => B () j) ᵥ* D⁻¹) ⬝ᵥ
              (fun j : r => C j ()) := by
              simp [Matrix.mul_apply, Matrix.vecMul, dotProduct]
      _ = (z ᵥ* X) ᵥ* D⁻¹ ⬝ᵥ (Xᵀ *ᵥ z) := by
              rw [hB, hC]
      _ = (z ᵥ* X) ⬝ᵥ (D⁻¹ *ᵥ (Xᵀ *ᵥ z)) := by
              exact (Matrix.dotProduct_mulVec (z ᵥ* X) D⁻¹ (Xᵀ *ᵥ z)).symm
      _ = z ⬝ᵥ (X *ᵥ (D⁻¹ *ᵥ (Xᵀ *ᵥ z))) := by
              exact (Matrix.dotProduct_mulVec z X (D⁻¹ *ᵥ (Xᵀ *ᵥ z))).symm
      _ = z ⬝ᵥ ((X * D⁻¹ * Xᵀ) *ᵥ z) := by
              simp [Matrix.mulVec_mulVec, Matrix.mul_assoc]
  change A () () - (B * D⁻¹ * C) () () =
    z ⬝ᵥ ((1 - X * D⁻¹ * Xᵀ) *ᵥ z)
  rw [hblock]
  simp [A, Matrix.sub_mulVec, Matrix.one_mulVec, dotProduct_sub,
    Matrix.mul_assoc]

