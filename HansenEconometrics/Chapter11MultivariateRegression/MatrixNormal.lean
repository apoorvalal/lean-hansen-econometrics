/-- The sample-centering projection kills every constant row vector. -/
@[simp]
theorem sampleCenteringMatrix_mulVec_const (c : ℝ) :
    sampleCenteringMatrix (n := n) *ᵥ (fun _ : n => c) = 0 := by
  classical
  have hconst : (fun _ : n => c) = c • (fun _ : n => (1 : ℝ)) := by
    ext i
    simp
  rw [hconst, Matrix.mulVec_smul, sampleCenteringMatrix_mulVec_one, smul_zero]

