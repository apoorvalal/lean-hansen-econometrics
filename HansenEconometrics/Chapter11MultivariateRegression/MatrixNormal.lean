/-- General coordinate-congruence invariance for Hansen's chi-square-normalized
inverse-Wishart scalar.

If `S` and `T` are two-sided inverse column transforms, then changing
coordinates by `T` in `Σ`, `W`, and the fixed direction `α` leaves
`(α'Σ⁻¹α) * (α'W⁻¹α)⁻¹` unchanged. This is the deterministic whitening
algebra used in Hansen Theorem 11.11; the remaining theorem-facing work is the
law transport for the named Wishart measures and the finite coordinate split. -/
theorem inverseWishartScaledLinearForm_congr_of_inverse
    (Sigma W : Matrix m m ℝ) (α : m → ℝ)
    (T S : Matrix m m ℝ)
    (hST : S * T = 1) (hTS : T * S = 1)
    (hSigma : IsUnit Sigma.det) (hW : IsUnit W.det) :
    inverseWishartScaledLinearForm (Tᵀ * Sigma * T) (Tᵀ *ᵥ α) (Tᵀ * W * T) =
      inverseWishartScaledLinearForm Sigma α W := by
  have hSigmaQuad :
      (Tᵀ *ᵥ α) ⬝ᵥ (((Tᵀ * Sigma * T)⁻¹ * Tᵀ) *ᵥ α) =
        α ⬝ᵥ (Sigma⁻¹ *ᵥ α) := by
    simpa [Matrix.mulVec_mulVec] using
      congr_quad_nonsingInv_of_inverse Sigma T S α hST hTS hSigma
  have hWQuad :
      (Tᵀ *ᵥ α) ⬝ᵥ (((Tᵀ * W * T)⁻¹ * Tᵀ) *ᵥ α) =
        α ⬝ᵥ (W⁻¹ *ᵥ α) := by
    simpa [Matrix.mulVec_mulVec] using
      congr_quad_nonsingInv_of_inverse W T S α hST hTS hW
  simp [inverseWishartScaledLinearForm, inverseWishartLinearForm,
    Matrix.mulVec_mulVec, hSigmaQuad, hWQuad]

