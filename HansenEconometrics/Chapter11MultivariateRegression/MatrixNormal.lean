/-- The `1`-eigenspace of the sample-centering matrix has cardinality `n - 1`
in Mathlib's Hermitian eigenbasis indexing. -/
theorem sampleCenteringMatrix_card_eigenvalues_eq_one [Nonempty n] :
    Fintype.card
        {i : n //
          (sampleCenteringMatrix_isHermitian (n := n)).eigenvalues i = 1} =
      Fintype.card n - 1 := by
  classical
  have hcard := rank_eq_card_eigenvalues_eq_one_of_isHermitian_idempotent
    (sampleCenteringMatrix_isHermitian (n := n))
    (sampleCenteringMatrix_isIdempotentElem (n := n))
  rw [sampleCenteringMatrix_rank] at hcard
  exact hcard.symm

