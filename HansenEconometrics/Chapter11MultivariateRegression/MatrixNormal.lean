      (Sigma := Sigma) (α := α)
      (T := T) (S := S) (c := c)
      hST hTS hSigma_det hW_nonsing hSigma_one hα_one hc hWishart
  exact
    inverseWishartLinearForm_hasLaw_theorem11_11_raw_of_standardCoordinate_congr
      (dfidx := dfidx) (r := r)
      (W := W) (Sigma := Sigma) (α := α)
      hSigma hα hW hcard hnonsing_std hdf hcongr

