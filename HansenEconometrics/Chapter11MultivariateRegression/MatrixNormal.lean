  let ρ : Measure ℝ := classicalFDist (Fintype.card m) (Fintype.card n - Fintype.card m)
  let unscale : ℝ → ℝ := fun y => scale⁻¹ * y
  have hs : scale ≠ 0 := by
    dsimp [scale]
    exact hotellingT2HansenScale_ne (n := n) (m := m) hm hν
  have hUnscaleLaw : HasLaw unscale ρ (ρ.map fun x : ℝ => scale * x) := by
