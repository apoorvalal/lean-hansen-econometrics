private lemma hotelling_ratio_algebra
    (N M A B : ℝ)
    (hM : M ≠ 0) (hD : N - M ≠ 0) (hA : A ≠ 0) (hB : B ≠ 0) :
    N * (N - 1) * B =
      (M * (N - 1) / (N - M)) *
        (((N * A) / M) / ((A * B⁻¹) / (N - M))) := by
  have hBinv : B⁻¹ ≠ 0 := inv_ne_zero hB
  have hAB : A * B⁻¹ ≠ 0 := mul_ne_zero hA hBinv
  field_simp [hM, hD, hA, hB, hBinv, hAB]

