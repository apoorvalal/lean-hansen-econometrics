/-- Centered contrasts remove a row-constant mean matrix. -/
theorem sampleContrastRows_const_eq_zero_of_centering
    {df : Type*} [Fintype df]
    (C : Matrix df n ℝ) (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n))
