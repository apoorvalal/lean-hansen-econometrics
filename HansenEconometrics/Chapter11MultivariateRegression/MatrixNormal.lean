  change (Fintype.card n : ℝ) * (d ⬝ᵥ (Sigma⁻¹ *ᵥ d)) =
    (fun a : m => c * d a) ⬝ᵥ (Sigma⁻¹ *ᵥ fun a : m => c * d a)
  change (Fintype.card n : ℝ) * (d ⬝ᵥ (Sigma⁻¹ *ᵥ d)) =
    (c • d) ⬝ᵥ (Sigma⁻¹ *ᵥ (c • d))
  rw [Matrix.mulVec_smul, dotProduct_smul, smul_dotProduct]
