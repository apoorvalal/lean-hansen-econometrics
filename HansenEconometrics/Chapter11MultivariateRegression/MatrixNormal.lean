/-- Deterministic standard-coordinate Schur identity for the inverse-Wishart
scalar under nonsingular full and nuisance Gram matrices.

This is the pointwise algebraic identity used by the projection-certificate
version of Hansen Theorem 11.11: in coordinates with `Σ = I` and `α = e₁`,
the inverse-Wishart scalar from `(YᵀY)⁻¹` is the residual quadratic form of
the first column after projecting out the nuisance columns. -/
theorem inverseWishartScaledLinearForm_one_standardCoordinate_eq_residualProjection_of_invertible
    {r : Type*} [Fintype r] [DecidableEq r]
    (Y : Matrix n (Sum Unit r) ℝ)
    [Invertible (matrixCrossProduct Y)]
    [Invertible ((standardCoordinateRestColumns (n := n) Y)ᵀ *
      standardCoordinateRestColumns (n := n) Y)] :
    inverseWishartScaledLinearForm
        (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ)
        (Pi.single (Sum.inl ()) (1 : ℝ))
        (matrixCrossProduct Y) =
      (standardCoordinateFirstColumn (n := n) Y : n → ℝ) ⬝ᵥ
        (gaussianResidualProjection (n := n)
            (standardCoordinateRestColumns (n := n) Y) *ᵥ
          (standardCoordinateFirstColumn (n := n) Y : n → ℝ)) := by
  classical
  let z : n → ℝ := (standardCoordinateFirstColumn (n := n) Y : n → ℝ)
  let X : Matrix n r ℝ := standardCoordinateRestColumns (n := n) Y
  let A : Matrix Unit Unit ℝ := fun _ _ => z ⬝ᵥ z
  let B : Matrix Unit r ℝ := fun _ j => z ⬝ᵥ fun i : n => X i j
  let C : Matrix r Unit ℝ := fun j _ => (fun i : n => X i j) ⬝ᵥ z
  let D : Matrix r r ℝ := Xᵀ * X
  let S : Matrix Unit Unit ℝ := A - B * ⅟D * C
  have hWblocks :
      matrixCrossProduct Y = Matrix.fromBlocks A B C D := by
    simpa [A, B, C, D, z, X] using
      matrixCrossProduct_standardCoordinate_eq_fromBlocks (n := n) (Y := Y)
  letI : Invertible (Matrix.fromBlocks A B C D) :=
    (inferInstance : Invertible (matrixCrossProduct Y)).copy
      (Matrix.fromBlocks A B C D) hWblocks.symm
  letI : Invertible S := by
    dsimp [S]
    exact Matrix.invertibleOfFromBlocks₂₂Invertible A B C D
  have hinvBlocks :
      ⅟(Matrix.fromBlocks A B C D) =
        Matrix.fromBlocks (⅟S) (-(⅟S * B * ⅟D))
          (-(⅟D * C * ⅟S))
          (⅟D + ⅟D * C * ⅟S * B * ⅟D) := by
    dsimp [S]
    exact Matrix.invOf_fromBlocks₂₂_eq A B C D
  have hlinear :
      inverseWishartLinearForm (Pi.single (Sum.inl ()) (1 : ℝ))
          (matrixCrossProduct Y) = S () () := by
    unfold inverseWishartLinearForm
    rw [hWblocks]
    rw [← Matrix.invOf_eq_nonsing_inv (Matrix.fromBlocks A B C D)]
    rw [hinvBlocks]
    simp [Matrix.mulVec, dotProduct]
  calc
    inverseWishartScaledLinearForm
        (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ)
        (Pi.single (Sum.inl ()) (1 : ℝ))
        (matrixCrossProduct Y)
        = inverseWishartLinearForm (Pi.single (Sum.inl ()) (1 : ℝ))
            (matrixCrossProduct Y) := by
            simp [inverseWishartScaledLinearForm, inv_one]
    _ = S () () := hlinear
    _ =
      (standardCoordinateFirstColumn (n := n) Y : n → ℝ) ⬝ᵥ
        (gaussianResidualProjection (n := n)
            (standardCoordinateRestColumns (n := n) Y) *ᵥ
          (standardCoordinateFirstColumn (n := n) Y : n → ℝ)) := by
        simpa [S, A, B, C, D, z, X] using
          standardCoordinate_schurComplement_invOf_eq_residualProjection
            (n := n) (Y := Y)

