/-- Canonical orthonormal contrast rows for the sample-centering projection,
indexed by the `1`-eigenspace of `I - n⁻¹11'`. The cardinality theorem
`sampleCenteringMatrix_card_eigenvalues_eq_one` identifies this row index with
Hansen's `n - 1` degrees of freedom. -/
noncomputable def sampleCenteringEigenContrast :
    Matrix {i : n // (sampleCenteringMatrix_isHermitian (n := n)).eigenvalues i = 1} n ℝ :=
  fun r j => ((sampleCenteringMatrix_isHermitian (n := n)).eigenvectorBasis r.1 :
    EuclideanSpace ℝ n) j

omit [Fintype m] [DecidableEq m] in
/-- The canonical centering contrast has orthonormal rows. -/
theorem sampleCenteringEigenContrast_mul_transpose :
    sampleCenteringEigenContrast (n := n) *
        (sampleCenteringEigenContrast (n := n))ᵀ = 1 := by
  classical
  ext r s
  rw [Matrix.mul_apply]
  have hinner := (orthonormal_iff_ite.mp
    (sampleCenteringMatrix_isHermitian (n := n)).eigenvectorBasis.orthonormal) r.1 s.1
  rw [EuclideanSpace.inner_eq_star_dotProduct] at hinner
  by_cases hrs : r = s
  · subst s
    simpa [sampleCenteringEigenContrast, Matrix.transpose_apply, dotProduct_comm,
      Pi.star_apply, conj_trivial] using hinner
  · have hidx : r.1 ≠ s.1 := by
      intro h
      exact hrs (Subtype.ext h)
    simpa [sampleCenteringEigenContrast, Matrix.transpose_apply, hidx, hrs,
      dotProduct_comm, Pi.star_apply, conj_trivial] using hinner

