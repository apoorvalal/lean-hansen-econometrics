/-- If the contrast matrix has orthonormal rows spanning the centered row
subspace, then the centered-row cross-product equals the contrast-row
cross-product. This is the deterministic cross-product identity used in
Hansen Theorem 11.10. -/
theorem matrixCrossProduct_centeredSampleMatrix_eq_contrast
    {df : Type*} [Fintype df] [DecidableEq df]
    (C : Matrix df n ℝ) (Y : n → m → ℝ)
    (hrows : C * Cᵀ = 1)
    (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n)) :
    matrixCrossProduct (centeredSampleMatrix Y) =
      matrixCrossProduct (sampleContrastRows (n := n) C Y) := by
  classical
  calc
    matrixCrossProduct (centeredSampleMatrix Y)
        = matrixCrossProduct
            (sampleCenteringMatrix (n := n) * sampleRowMatrix Y) := by
              rw [sampleCenteringMatrix_mul_eq_centeredSampleMatrix]
    _ = (sampleRowMatrix Y)ᵀ *
          ((sampleCenteringMatrix (n := n))ᵀ * sampleCenteringMatrix (n := n)) *
          sampleRowMatrix Y := by
              simp [matrixCrossProduct, Matrix.transpose_mul, Matrix.mul_assoc]
    _ = (sampleRowMatrix Y)ᵀ * (Cᵀ * C) * sampleRowMatrix Y := by
              have hproj : (Cᵀ * C)ᵀ * (Cᵀ * C) = Cᵀ * C := by
                calc
                  (Cᵀ * C)ᵀ * (Cᵀ * C)
                      = (Cᵀ * C) * (Cᵀ * C) := by
                          simp [Matrix.transpose_mul]
                  _ = Cᵀ * (C * (Cᵀ * C)) := by
                          rw [Matrix.mul_assoc]
                  _ = Cᵀ * ((C * Cᵀ) * C) := by
                          rw [Matrix.mul_assoc C Cᵀ C]
                  _ = Cᵀ * C := by
                          rw [hrows]
                          simp
              rw [← hcenter]
              rw [hproj]
    _ = matrixCrossProduct (sampleContrastRows (n := n) C Y) := by
              rw [matrixCrossProduct_sampleContrastRows]

