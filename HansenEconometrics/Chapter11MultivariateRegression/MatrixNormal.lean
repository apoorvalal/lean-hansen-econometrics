    {q : Type*} [Fintype q] [DecidableEq q]
    (d : m → ℝ) (hd : d ≠ 0)
    (hcard_dim : Fintype.card q = Fintype.card m) (first : q) :
  ∃ (Q : Matrix m q ℝ) (R : Matrix q m ℝ) (c : ℝ),
      R * Q = 1 ∧ Q * R = 1 ∧ Qᵀ * Q = 1 ∧
        Qᵀ *ᵥ d = c • (Pi.single first (1 : ℝ) : q → ℝ) ∧ c ≠ 0 := by
  classical
  let dE : EuclideanSpace ℝ m := WithLp.toLp 2 d
  have hdE : dE ≠ 0 := by
    intro h
    apply hd
    have hfun := congrArg (fun x : EuclideanSpace ℝ m => x.ofLp) h
    simpa [dE] using hfun
  let u : EuclideanSpace ℝ m := (‖dE‖)⁻¹ • dE
  have hu_norm : ‖u‖ = 1 := by
    have hd_norm : ‖dE‖ ≠ 0 := norm_ne_zero_iff.mpr hdE
    change ‖(‖dE‖)⁻¹ • dE‖ = 1
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg dE)),
      inv_mul_cancel₀ hd_norm]
  let support : Set q := {first}
  have horth : Orthonormal ℝ (support.restrict fun _ : q => u) := by
    rw [orthonormal_iff_ite]
    rintro ⟨i, hi⟩ ⟨j, hj⟩
    have hi' : i = first := by simpa [support] using hi
    have hj' : j = first := by simpa [support] using hj
    subst i
    subst j
    simp [Set.restrict, hu_norm]
  have hfinrank : Module.finrank ℝ (EuclideanSpace ℝ m) = Fintype.card q := by
    simpa [hcard_dim] using
      (EuclideanSpace.finrank_euclideanSpace (𝕜 := ℝ) (ι := m))
  obtain ⟨b, hb_first⟩ :=
    Orthonormal.exists_orthonormalBasis_extension_of_card_eq
      (𝕜 := ℝ) (E := EuclideanSpace ℝ m) (ι := q)
      (card_ι := hfinrank) (v := fun _ : q => u) (s := support) horth
  let Q : Matrix m q ℝ := (EuclideanSpace.basisFun m ℝ).toBasis.toMatrix b
  let R : Matrix q m ℝ := Qᵀ
  let c : ℝ := (Qᵀ *ᵥ d) first
  have hQTQ : Qᵀ * Q = (1 : Matrix q q ℝ) := by
    simpa [Q, Matrix.conjTranspose_eq_transpose_of_trivial] using
      (EuclideanSpace.basisFun m ℝ).toMatrix_orthonormalBasis_conjTranspose_mul_self b
  have hQQT : Q * Qᵀ = (1 : Matrix m m ℝ) := by
    simpa [Q, Matrix.conjTranspose_eq_transpose_of_trivial] using
      (EuclideanSpace.basisFun m ℝ).toMatrix_orthonormalBasis_self_mul_conjTranspose b
  have hfirst : b first = u := by
    exact hb_first first (by simp [support])
  have hα_one :
      Qᵀ *ᵥ d = c • (Pi.single first (1 : ℝ) : q → ℝ) := by
    ext j
    by_cases hj : j = first
    · subst j
      simp [c]
    · have hbj : inner ℝ (b j) (b first) = 0 := by
        simpa [hj] using (b.inner_eq_zero hj)
      have hscale_ne : (‖dE‖)⁻¹ ≠ 0 := by
        exact inv_ne_zero (norm_ne_zero_iff.mpr hdE)
      have hdot : d ⬝ᵥ (b j).ofLp = 0 := by
        have hdot' : (‖dE‖)⁻¹ * (d ⬝ᵥ (b j).ofLp) = 0 := by
          rw [hfirst] at hbj
          change inner ℝ (b j) ((‖dE‖)⁻¹ • dE) = 0 at hbj
          rw [inner_smul_right] at hbj
          simpa [dE, EuclideanSpace.inner_eq_star_dotProduct, dotProduct_comm,
            Pi.star_apply, conj_trivial] using hbj
        exact (mul_eq_zero.mp hdot').resolve_left hscale_ne
      have hdot_rev : (b j).ofLp ⬝ᵥ d = 0 := by
        simpa [dotProduct_comm] using hdot
      have hcoord_j : (Qᵀ *ᵥ d) j = (b j).ofLp ⬝ᵥ d := by
        have hentry : ∀ x : m,
            (EuclideanSpace.basisFun m ℝ).toBasis.toMatrix (⇑b) x j =
              (b j).ofLp x := by
          intro x
          simpa [Module.Basis.toMatrix_apply, EuclideanSpace.basisFun_toBasis] using
            (EuclideanSpace.basisFun_repr (𝕜 := ℝ) (x := b j) x)
        simp [Q, Matrix.mulVec, dotProduct, hentry]
      calc
        (Qᵀ *ᵥ d) j = (b j).ofLp ⬝ᵥ d := hcoord_j
        _ = 0 := hdot_rev
        _ = (c • (Pi.single first (1 : ℝ) : q → ℝ)) j := by
          simp [Pi.single, hj]
  have hc : c ≠ 0 := by
    have hscale_ne : (‖dE‖)⁻¹ ≠ 0 := by
      exact inv_ne_zero (norm_ne_zero_iff.mpr hdE)
    have hdot_ne : d ⬝ᵥ (b first).ofLp ≠ 0 := by
      have hdot_self_ne : d ⬝ᵥ d ≠ 0 := by
        intro hzero
        exact hd (dotProduct_self_eq_zero.mp hzero)
      have hdot_first :
          d ⬝ᵥ (b first).ofLp = (‖dE‖)⁻¹ * (d ⬝ᵥ d) := by
        simp [hfirst, u, dE, dotProduct_comm, smul_eq_mul,
          mul_assoc, mul_comm, mul_left_comm]
      rw [hdot_first]
      exact mul_ne_zero hscale_ne hdot_self_ne
    change (Qᵀ *ᵥ d) first ≠ 0
    have hcoord_first : (Qᵀ *ᵥ d) first = d ⬝ᵥ (b first).ofLp := by
      have hentry : ∀ x : m,
          (EuclideanSpace.basisFun m ℝ).toBasis.toMatrix (⇑b) x first =
            (b first).ofLp x := by
        intro x
        simpa [Module.Basis.toMatrix_apply, EuclideanSpace.basisFun_toBasis] using
          (EuclideanSpace.basisFun_repr (𝕜 := ℝ) (x := b first) x)
      simp [Q, Matrix.mulVec, dotProduct, hentry, mul_comm]
    rw [hcoord_first]
    exact hdot_ne
  exact ⟨Q, R, c, by simpa [R] using hQTQ, by simpa [R] using hQQT,
    hQTQ, hα_one, hc⟩

/-- Deterministic whitening/alignment data for the standard-coordinate
reduction in Hansen Theorems 11.11 and 11.12.

For positive-definite `Σ` and a nonzero direction `α`, the positive square root
`B = √Σ` whitens by `B⁻¹`; an ordinary orthogonal rotation then sends
`B⁻¹α` to the first standard coordinate. -/
theorem standardCoordinate_whitening_alignment_exists_of_posDef
    {r : Type*} [Fintype r] [DecidableEq r]
    (Sigma : Matrix m m ℝ) (α : m → ℝ)
    (hSigma : Sigma.PosDef) (hα : α ≠ 0)
    (hcard_dim : Fintype.card (Sum Unit r) = Fintype.card m) :
    ∃ (T : Matrix m (Sum Unit r) ℝ) (S : Matrix (Sum Unit r) m ℝ) (c : ℝ),
      S * T = 1 ∧ T * S = 1 ∧
        Tᵀ * Sigma * T = (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ) ∧
        Tᵀ *ᵥ α =
          c • (Pi.single (Sum.inl ()) (1 : ℝ) : Sum Unit r → ℝ) ∧
        c ≠ 0 := by
  classical
  let B : Matrix m m ℝ := CFC.sqrt Sigma
  have hB_pos : B.PosDef := by
    simpa [B] using hSigma.isStrictlyPositive.sqrt.posDef
  have hBdet : IsUnit B.det :=
    B.isUnit_iff_isUnit_det.mp hB_pos.isUnit
  have hBB : B * B = Sigma := by
    simpa [B] using CFC.sqrt_mul_sqrt_self Sigma hSigma.posSemidef.nonneg
  have hB_trans : Bᵀ = B := by
    have hHerm : B.IsHermitian := hB_pos.1
    simpa [Matrix.conjTranspose] using hHerm.eq
  have hBinv_trans : B⁻¹ᵀ = B⁻¹ := by
    rw [Matrix.transpose_nonsing_inv, hB_trans]
  let d : m → ℝ := B⁻¹ *ᵥ α
  have hBd : B *ᵥ d = α := by
    calc
      B *ᵥ d = (B * B⁻¹) *ᵥ α := by
        simp [d, Matrix.mulVec_mulVec]
      _ = α := by
        rw [Matrix.mul_nonsing_inv B hBdet, Matrix.one_mulVec]
  have hd : d ≠ 0 := by
    intro hzero
    apply hα
    rw [← hBd, hzero, Matrix.mulVec_zero]
  obtain ⟨Q, R, c, hRQ, hQR, hQTQ, hQd, hc⟩ :=
    standardCoordinate_orthogonal_alignment_exists
      (m := m) (q := Sum Unit r) d hd hcard_dim (Sum.inl ())
  let T : Matrix m (Sum Unit r) ℝ := B⁻¹ * Q
  let S : Matrix (Sum Unit r) m ℝ := R * B
  have hST : S * T = 1 := by
    calc
      S * T = (R * B) * (B⁻¹ * Q) := rfl
      _ = R * ((B * B⁻¹) * Q) := by simp [Matrix.mul_assoc]
      _ = R * ((1 : Matrix m m ℝ) * Q) := by rw [Matrix.mul_nonsing_inv B hBdet]
      _ = R * Q := by rw [Matrix.one_mul]
      _ = 1 := hRQ
  have hTS : T * S = 1 := by
    calc
      T * S = (B⁻¹ * Q) * (R * B) := rfl
      _ = B⁻¹ * ((Q * R) * B) := by simp [Matrix.mul_assoc]
      _ = B⁻¹ * ((1 : Matrix m m ℝ) * B) := by rw [hQR]
      _ = B⁻¹ * B := by rw [Matrix.one_mul]
      _ = 1 := by rw [Matrix.nonsing_inv_mul B hBdet]
  have hmid : B⁻¹ᵀ * Sigma * B⁻¹ = (1 : Matrix m m ℝ) := by
    rw [hBinv_trans, ← hBB]
    calc
      B⁻¹ * (B * B) * B⁻¹ = (B⁻¹ * B) * (B * B⁻¹) := by
        simp [Matrix.mul_assoc]
      _ = (1 : Matrix m m ℝ) * (1 : Matrix m m ℝ) := by
        rw [Matrix.nonsing_inv_mul B hBdet, Matrix.mul_nonsing_inv B hBdet]
      _ = 1 := by rw [Matrix.one_mul]
  have hSigma_one :
      Tᵀ * Sigma * T = (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ) := by
    calc
      Tᵀ * Sigma * T = (B⁻¹ * Q)ᵀ * Sigma * (B⁻¹ * Q) := rfl
      _ = (Qᵀ * B⁻¹ᵀ) * Sigma * (B⁻¹ * Q) := by
        rw [Matrix.transpose_mul]
      _ = Qᵀ * (B⁻¹ᵀ * Sigma * B⁻¹) * Q := by
        simp [Matrix.mul_assoc]
      _ = Qᵀ * (1 : Matrix m m ℝ) * Q := by rw [hmid]
      _ = Qᵀ * Q := by rw [Matrix.mul_one]
      _ = 1 := hQTQ
  have hα_one :
      Tᵀ *ᵥ α =
        c • (Pi.single (Sum.inl ()) (1 : ℝ) : Sum Unit r → ℝ) := by
    calc
      Tᵀ *ᵥ α = (B⁻¹ * Q)ᵀ *ᵥ α := rfl
      _ = (Qᵀ * B⁻¹ᵀ) *ᵥ α := by rw [Matrix.transpose_mul]
      _ = Qᵀ *ᵥ (B⁻¹ᵀ *ᵥ α) := by rw [Matrix.mulVec_mulVec]
      _ = Qᵀ *ᵥ (B⁻¹ *ᵥ α) := by rw [hBinv_trans]
      _ = Qᵀ *ᵥ d := rfl
      _ = c • (Pi.single (Sum.inl ()) (1 : ℝ) : Sum Unit r → ℝ) := hQd
  exact ⟨T, S, c, hST, hTS, hSigma_one, hα_one, hc⟩

