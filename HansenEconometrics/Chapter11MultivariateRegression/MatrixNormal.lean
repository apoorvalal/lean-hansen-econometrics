/-- The chi-square-normalized inverse-Wishart scalar is invariant under
nonzero rescaling of the fixed direction `α`.

This is a deterministic coordinate-alignment bridge for Hansen Theorem 11.11:
after whitening and rotating a nonzero vector to a coordinate axis, its norm
does not affect `inverseWishartScaledLinearForm`. -/
@[simp]
theorem inverseWishartScaledLinearForm_smul_alpha
    (Sigma : Matrix m m ℝ) (α : m → ℝ) (W : Matrix m m ℝ)
    {c : ℝ} (hc : c ≠ 0) :
    inverseWishartScaledLinearForm Sigma (c • α) W =
      inverseWishartScaledLinearForm Sigma α W := by
  let a : ℝ := α ⬝ᵥ (Sigma⁻¹ *ᵥ α)
  let b : ℝ := α ⬝ᵥ (W⁻¹ *ᵥ α)
  have hSigma :
      (c • α) ⬝ᵥ (Sigma⁻¹ *ᵥ (c • α)) = (c * c) * a := by
    simp [a, Matrix.mulVec_smul, dotProduct_smul, smul_dotProduct,
      smul_eq_mul, mul_assoc]
  have hW :
      (c • α) ⬝ᵥ (W⁻¹ *ᵥ (c • α)) = (c * c) * b := by
    simp [b, Matrix.mulVec_smul, dotProduct_smul, smul_dotProduct,
      smul_eq_mul, mul_assoc]
  have hcc : c * c ≠ 0 := mul_ne_zero hc hc
  unfold inverseWishartScaledLinearForm inverseWishartLinearForm
  rw [hSigma, hW]
  calc
    (c * c * a) * (c * c * b)⁻¹
        = (c * c * a) * (b⁻¹ * (c * c)⁻¹) := by
            rw [_root_.mul_inv_rev]
    _ = ((c * c) * (c * c)⁻¹) * (a * b⁻¹) := by ring
    _ = a * b⁻¹ := by rw [mul_inv_cancel₀ hcc, one_mul]

