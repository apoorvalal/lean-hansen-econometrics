/-- Adding a row-constant mean does not change centered contrast rows. -/
theorem sampleContrastRows_add_const_eq_of_centering
    {df : Type*} [Fintype df]
    (C : Matrix df n ℝ) (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n))
    (Y : n → m → ℝ) (mean : m → ℝ) :
    sampleContrastRows (n := n) C (fun i a => Y i a + mean a) =
      sampleContrastRows (n := n) C Y := by
  classical
  ext i a
  have hmean :
      ∑ x : n, C i x * mean a = 0 := by
    have hrow :
        (sampleContrastRows (n := n) C (fun _ : n => mean)) i a = 0 := by
      simpa using congr_fun
        (congr_fun
          (sampleContrastRows_const_eq_zero_of_centering
            (C := C) hcenter mean) i) a
    simpa [sampleContrastRows, sampleRowMatrix, Matrix.mul_apply] using hrow
  have hsum :
      ∑ x : n, C i x * (Y x a + mean a) = ∑ x : n, C i x * Y x a := by
    calc
      ∑ x : n, C i x * (Y x a + mean a)
          = ∑ x : n, (C i x * Y x a + C i x * mean a) := by
              refine Finset.sum_congr rfl ?_
              intro x _
              ring
      _ = ∑ x : n, C i x * Y x a + ∑ x : n, C i x * mean a := by
              rw [Finset.sum_add_distrib]
      _ = ∑ x : n, C i x * Y x a := by
              rw [hmean, add_zero]
  simpa [sampleContrastRows, sampleRowMatrix, Matrix.mul_apply] using hsum

