theorem inverseWishartLinearForm_hasLaw_theorem11_11_raw_of_standardCoordinate_matrixGaussian_transport
    {dfidx r : Type*} [Fintype dfidx] [Fintype r] [DecidableEq r]
    (W : Ω → Matrix m m ℝ) (Sigma : Matrix m m ℝ) (α : m → ℝ)
