/-- Standard-coordinate whitening image of Hansen's iid matrix-normal law.

If `TᵀΣT = I`, then right-multiplying the centered sample matrix by `T`
transports the iid matrix-Gaussian law to the standard-coordinate iid law. -/
theorem iidMatrixGaussianLaw_standardCoordinate_whiten_map
    {r : Type*} [Fintype r] [DecidableEq r]
    {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (T : Matrix m (Sum Unit r) ℝ)
    (hSigma_one :
      Tᵀ * Sigma * T = (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ)) :
    (iidMatrixGaussianLaw (n := n) (m := m) (0 : m → ℝ) Sigma).map
        (fun Y : Matrix n m ℝ => Y * T) =
      iidMatrixGaussianLaw (n := n) (m := Sum Unit r)
        (0 : Sum Unit r → ℝ) (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ) := by
  have hmap := iidMatrixGaussianLaw_columnMap
    (n := n) (m := m) (q := Sum Unit r)
    (mean := (0 : m → ℝ)) hSigma T
  simpa [hSigma_one] using hmap

omit [DecidableEq n] in
/-- Independent Gaussian rows have the finite product row law.

This is the row-level bridge from Hansen's iid sampling language to the product
law used by `iidMatrixGaussianLaw`. The later matrix-cast law remains packaged
in `iidMatrixGaussianLaw`, so this theorem does not assert any centered
sample-covariance or Wishart conclusion by itself. -/
theorem iidRows_hasLaw_pi_rowGaussianLaw
    [IsProbabilityMeasure μ] (Y : Ω → n → m → ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ) :
    HasLaw Y ((Measure.pi fun _ : n => rowGaussianLaw mean Sigma) :
      Measure (n → m → ℝ)) μ := by
  have hAe : ∀ i : n, AEMeasurable (fun ω => Y ω i) μ :=
    fun i => (hrow i).aemeasurable
  refine ⟨aemeasurable_pi_lambda Y hAe, ?_⟩
  have hmap := (iIndepFun_iff_map_fun_eq_pi_map hAe).1 hInd
  rw [hmap]
  congr
  funext i
  exact (hrow i).map_eq

omit [DecidableEq n] in
/-- Independent Gaussian rows have Hansen's matrix-normal product law.

This packages `iidRows_hasLaw_pi_rowGaussianLaw` with the matrix cast used in
`iidMatrixGaussianLaw`, so later Wishart statements can consume a matrix-valued
sample directly. -/
theorem iidRows_hasLaw_iidMatrixGaussianLaw
    [IsProbabilityMeasure μ] (Y : Ω → Matrix n m ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ) :
    HasLaw Y (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma) μ := by
  let hPi := iidRows_hasLaw_pi_rowGaussianLaw
    (μ := μ) (Y := fun ω i => Y ω i) mean Sigma hrow hInd
  let hcast : HasLaw (fun Y : n → m → ℝ => (Y : Matrix n m ℝ))
      (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma)
      ((Measure.pi fun _ : n => rowGaussianLaw mean Sigma) :
        Measure (n → m → ℝ)) :=
    ⟨by
      have hle :
          matrixBorelMeasurableSpaceInst (ι := n) (κ := m) ≤
            (inferInstance : MeasurableSpace (n → m → ℝ)) := by
        have hPiBorel :
            @BorelSpace (n → m → ℝ) _ (inferInstance : MeasurableSpace (n → m → ℝ)) :=
          inferInstance
        have hEq : (inferInstance : MeasurableSpace (n → m → ℝ)) =
            borel (n → m → ℝ) :=
          @BorelSpace.measurable_eq (n → m → ℝ) _
            (inferInstance : MeasurableSpace (n → m → ℝ)) hPiBorel
        simpa [matrixBorelMeasurableSpaceInst, matrixBorelMeasurableSpace] using
          le_of_eq hEq.symm
      have hmeas :
          @Measurable (Matrix n m ℝ) (Matrix n m ℝ)
            (inferInstance : MeasurableSpace (n → m → ℝ))
            (matrixBorelMeasurableSpaceInst (ι := n) (κ := m)) id :=
        measurable_id'' hle
      exact hmeas.aemeasurable,
      rfl⟩
  simpa using hcast.comp hPi

/-- Hansen Wishart law `W_m(n, Σ)`, represented as the cross-product
push-forward of iid centered Gaussian rows. -/
noncomputable def wishartLaw (Sigma : Matrix m m ℝ) : Measure (Matrix m m ℝ) :=
  wishartMatrixLaw (iidMatrixGaussianLaw (n := n) (m := m) (0 : m → ℝ) Sigma)

instance wishartLaw_sfinite (Sigma : Matrix m m ℝ) :
    SFinite (wishartLaw (n := n) (m := m) Sigma) := by
  rw [wishartLaw]
  infer_instance

/-- Hansen scaled Wishart law, used for sample covariance matrices. -/
noncomputable def scaledWishartLaw
    (c : ℝ) (Sigma : Matrix m m ℝ) : Measure (Matrix m m ℝ) :=
  scaledWishartMatrixLaw c
    (iidMatrixGaussianLaw (n := n) (m := m) (0 : m → ℝ) Sigma)

instance scaledWishartLaw_sfinite (c : ℝ) (Sigma : Matrix m m ℝ) :
    SFinite (scaledWishartLaw (n := n) (m := m) c Sigma) := by
  rw [scaledWishartLaw]
  infer_instance

/-- Scalar inverse-Wishart linear form in Hansen Theorem 11.11. -/
noncomputable def inverseWishartLinearForm
    (α : m → ℝ) (W : Matrix m m ℝ) : ℝ :=
  (α ⬝ᵥ (W⁻¹ *ᵥ α))⁻¹

/-- Hansen's chi-square-normalized inverse-Wishart linear form
`(α'Σ⁻¹α) * (α'W⁻¹α)⁻¹`.

Equivalently, Hansen's raw form satisfies
`(α'W⁻¹α)⁻¹ ∼ χ² / (α'Σ⁻¹α)`. -/
noncomputable def inverseWishartScaledLinearForm
    (Sigma : Matrix m m ℝ) (α : m → ℝ) (W : Matrix m m ℝ) : ℝ :=
  (α ⬝ᵥ (Sigma⁻¹ *ᵥ α)) * inverseWishartLinearForm α W

/-- Hotelling's `T²` statistic. -/
noncomputable def hotellingT2
    (root : ℝ) (Ybar μ0 : m → ℝ) (Shat : Matrix m m ℝ) : ℝ :=
  root * ((Ybar - μ0) ⬝ᵥ (Shat⁻¹ *ᵥ (Ybar - μ0)))

omit [DecidableEq n] [DecidableEq m] in
/-- Sample mean vector for rows indexed by observations. -/
noncomputable def sampleMeanMatrix (Y : n → m → ℝ) : m → ℝ :=
  (Fintype.card n : ℝ)⁻¹ • ∑ i : n, Y i

omit [DecidableEq n] [DecidableEq m] in
/-- Centered sample-row matrix `Yᵢ - Ȳ`. -/
noncomputable def centeredSampleMatrix (Y : n → m → ℝ) : Matrix n m ℝ :=
  fun i a => Y i a - sampleMeanMatrix Y a

omit [DecidableEq n] [DecidableEq m] in
/-- Bias-corrected sample covariance matrix `(n-1)⁻¹∑(Yᵢ-Ȳ)(Yᵢ-Ȳ)'`. -/
noncomputable def sampleCovarianceMatrix (Y : n → m → ℝ) : Matrix m m ℝ :=
  ((Fintype.card n - 1 : ℝ)⁻¹) • matrixCrossProduct (centeredSampleMatrix Y)

omit [DecidableEq n] [DecidableEq m] in
/-- Hansen's Hotelling statistic
`n(Ȳ-μ₀)'S⁻¹(Ȳ-μ₀)` built from the sample mean and sample covariance. -/
noncomputable def hotellingT2Sample (Y : n → m → ℝ) (μ0 : m → ℝ) : ℝ :=
  hotellingT2 (Fintype.card n : ℝ) (sampleMeanMatrix Y) μ0 (sampleCovarianceMatrix Y)

omit [DecidableEq n] [DecidableEq m] in
/-- Hansen's fixed Hotelling scale `m(n-1)/(n-m)` for the `F(m,n-m)` law. -/
noncomputable def hotellingT2HansenScale : ℝ :=
  ((Fintype.card m : ℝ) * ((Fintype.card n : ℝ) - 1)) /
    ((Fintype.card n : ℝ) - (Fintype.card m : ℝ))

omit [DecidableEq n] in
/-- Hansen's normalized Hotelling statistic
`((m(n-1))/(n-m))⁻¹ T²`.

When `0 < m < n`, this is the displayed textbook normalization
`((n-m)/(m(n-1))) T²`. -/
noncomputable def hotellingT2HansenFStatistic
    (Y : n → m → ℝ) (μ0 : m → ℝ) : ℝ :=
  (hotellingT2HansenScale (n := n) (m := m))⁻¹ * hotellingT2Sample Y μ0

omit [DecidableEq n] [DecidableEq m] in
/-- The fixed Hotelling scale is nonzero under Hansen's degrees-of-freedom
conditions `0 < m` and `0 < n - m`. -/
theorem hotellingT2HansenScale_ne
    (hm : 0 < Fintype.card m) (hν : 0 < Fintype.card n - Fintype.card m) :
    hotellingT2HansenScale (n := n) (m := m) ≠ 0 := by
  classical
  have hm_ne : (Fintype.card m : ℝ) ≠ 0 := by
    exact_mod_cast (ne_of_gt hm)
  have hmn : Fintype.card m < Fintype.card n := Nat.sub_pos_iff_lt.mp hν
  have hD_ne : (Fintype.card n : ℝ) - (Fintype.card m : ℝ) ≠ 0 := by
    exact ne_of_gt (sub_pos.mpr (by exact_mod_cast hmn))
  have hn_one : 1 < Fintype.card n :=
    lt_of_le_of_lt (Nat.succ_le_of_lt hm) hmn
  have hN1_ne : (Fintype.card n : ℝ) - 1 ≠ 0 := by
    exact sub_ne_zero.mpr (by exact_mod_cast (ne_of_gt hn_one))
  unfold hotellingT2HansenScale
  exact div_ne_zero (mul_ne_zero hm_ne hN1_ne) hD_ne

omit [Fintype m] [DecidableEq n] [DecidableEq m] in
/-- Coordinate form of the bias-corrected sample covariance. -/
theorem sampleCovarianceMatrix_apply
    (Y : n → m → ℝ) (a b : m) :
    sampleCovarianceMatrix Y a b =
      ((Fintype.card n - 1 : ℝ)⁻¹) *
        ∑ i : n, (Y i a - sampleMeanMatrix Y a) *
          (Y i b - sampleMeanMatrix Y b) := by
  simp [sampleCovarianceMatrix, matrixCrossProduct, centeredSampleMatrix, Matrix.mul_apply,
    smul_eq_mul]

omit [DecidableEq n] [DecidableEq m] in
/-- Row samples as a matrix, used to keep matrix products explicit. -/
noncomputable def sampleRowMatrix (Y : n → m → ℝ) : Matrix n m ℝ :=
  fun i a => Y i a

omit [DecidableEq m] in
/-- The finite-sample centering projection `I - n⁻¹ 11'` on observation rows. -/
noncomputable def sampleCenteringMatrix : Matrix n n ℝ :=
  1 - (show Matrix n n ℝ from fun _ _ => (Fintype.card n : ℝ)⁻¹)

omit [Fintype m] [DecidableEq m] in
/-- The sample-centering matrix is symmetric. -/
theorem sampleCenteringMatrix_transpose :
    (sampleCenteringMatrix (n := n))ᵀ = sampleCenteringMatrix (n := n) := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp [sampleCenteringMatrix]
  · have hji : ¬ j = i := fun h => hij h.symm
    simp [sampleCenteringMatrix, hij, hji]

omit [Fintype m] [DecidableEq m] in
/-- The sample-centering matrix is Hermitian. -/
theorem sampleCenteringMatrix_isHermitian :
    (sampleCenteringMatrix (n := n)).IsHermitian :=
  (Matrix.conjTranspose_eq_transpose_of_trivial _).trans
    (sampleCenteringMatrix_transpose (n := n))

omit [Fintype m] [DecidableEq m] in
/-- The sample-centering matrix is idempotent. -/
theorem sampleCenteringMatrix_mul_self :
    sampleCenteringMatrix (n := n) * sampleCenteringMatrix (n := n) =
      sampleCenteringMatrix (n := n) := by
  classical
  ext i j
  let N : ℝ := Fintype.card n
  let a : ℝ := N⁻¹
  have hN_nat : Fintype.card n ≠ 0 := by
    letI : Nonempty n := ⟨i⟩
    exact Fintype.card_ne_zero
  have hN : N ≠ 0 := by
    dsimp [N]
    exact_mod_cast hN_nat
  have hNa : N * a = 1 := by
    simp [N, a, hN]
  have hdelta :
      ∑ k : n,
          (if i = k then (1 : ℝ) else 0) *
            (if k = j then (1 : ℝ) else 0) =
        (if i = j then (1 : ℝ) else 0) := by
    by_cases hij : i = j
    · subst j
      rw [if_pos rfl]
      rw [Finset.sum_eq_single i]
      · simp
      · intro b _ hb
        simp [hb.symm]
      · intro hnot
        exact False.elim (hnot (Finset.mem_univ i))
    · rw [if_neg hij]
      refine Finset.sum_eq_zero ?_
      intro k _
      by_cases hik : i = k
      · subst k
        simp [hij]
      · simp [hik]
  have hleft :
      ∑ k : n, (if i = k then (1 : ℝ) else 0) = 1 := by
    rw [Finset.sum_eq_single i]
    · simp
    · intro b _ hb
      simp [hb.symm]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ i))
  have hright :
      ∑ k : n, (if k = j then (1 : ℝ) else 0) = 1 := by
    rw [Finset.sum_eq_single j]
    · simp
    · intro b _ hb
      simp [hb]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ j))
  have hconst : ∑ _ : n, a * a = N * (a * a) := by
    simp [N, nsmul_eq_mul]
  have hNaa : N * (a * a) = a := by
    calc
      N * (a * a) = (N * a) * a := by ring
      _ = a := by rw [hNa, one_mul]
  have hsum_right :
      (∑ k : n, a * (if k = j then (1 : ℝ) else 0)) =
        a * (∑ k : n, (if k = j then (1 : ℝ) else 0)) := by
    rw [← Finset.mul_sum]
  have hsum_left :
      (∑ k : n, (if i = k then (1 : ℝ) else 0) * a) =
        a * (∑ k : n, (if i = k then (1 : ℝ) else 0)) := by
    rw [← Finset.sum_mul]
    ring
  calc
    (sampleCenteringMatrix (n := n) * sampleCenteringMatrix (n := n)) i j
        = ∑ k : n,
            (((if i = k then (1 : ℝ) else 0) - a) *
              ((if k = j then (1 : ℝ) else 0) - a)) := by
          simp [sampleCenteringMatrix, Matrix.mul_apply, Matrix.one_apply, N, a]
    _ = (∑ k : n,
            (if i = k then (1 : ℝ) else 0) *
              (if k = j then (1 : ℝ) else 0)) -
          a * (∑ k : n, (if i = k then (1 : ℝ) else 0)) -
          a * (∑ k : n, (if k = j then (1 : ℝ) else 0)) +
          ∑ _ : n, a * a := by
          simp only [sub_mul, mul_sub, Finset.sum_sub_distrib]
          rw [hsum_right, hsum_left]
          ring
    _ = (if i = j then (1 : ℝ) else 0) - a := by
          rw [hdelta, hleft, hright, hconst, hNaa]
          ring
    _ = sampleCenteringMatrix (n := n) i j := by
          simp [sampleCenteringMatrix, Matrix.one_apply, N, a]

