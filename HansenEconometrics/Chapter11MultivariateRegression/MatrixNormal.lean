/-- Coordinate covariances across distinct independent normal rows are zero. -/
theorem iidNormalRows_covariance_eval_ne
    [IsProbabilityMeasure μ] (Y : Ω → Matrix n m ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ)
    {i j : n} (hij : i ≠ j) (a b : m) :
    cov[fun ω => Y ω i a, fun ω => Y ω j b; μ] = 0 := by
  have hmem_i := iidNormalRows_memLp_eval
    (Y := Y) (mean := mean) (Sigma := Sigma) hrow i a
  have hmem_j := iidNormalRows_memLp_eval
    (Y := Y) (mean := mean) (Sigma := Sigma) hrow j b
  have hind_rows : IndepFun (fun ω => Y ω i) (fun ω => Y ω j) μ :=
    hInd.indepFun hij
  have hind :
      IndepFun (fun ω => Y ω i a) (fun ω => Y ω j b) μ :=
    hind_rows.comp
      (measurable_pi_apply (X := fun _ : m => ℝ) a)
      (measurable_pi_apply (X := fun _ : m => ℝ) b)
  exact hind.covariance_eq_zero hmem_i hmem_j

