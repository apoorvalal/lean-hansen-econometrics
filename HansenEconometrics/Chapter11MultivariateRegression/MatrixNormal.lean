    (fun Y : n → Sum Unit r → ℝ => fun p : n × r => Y p.1 (Sum.inr p.2)) := by
  classical
  let rowLaw : Measure (Sum Unit r → ℝ) :=
    rowGaussianLaw (0 : Sum Unit r → ℝ)
      (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ)
  let piLaw : Measure (n → Sum Unit r → ℝ) :=
    Measure.pi fun _ : n => rowLaw
