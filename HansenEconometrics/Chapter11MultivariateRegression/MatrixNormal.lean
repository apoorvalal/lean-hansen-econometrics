/-- The sample-centering matrix has rank `n - 1`. -/
theorem sampleCenteringMatrix_rank [Nonempty n] :
    (sampleCenteringMatrix (n := n)).rank = Fintype.card n - 1 := by
  classical
  have htrace := rank_eq_natCast_trace_of_isHermitian_idempotent
    (sampleCenteringMatrix_isHermitian (n := n))
    (sampleCenteringMatrix_isIdempotentElem (n := n))
  rw [sampleCenteringMatrix_trace] at htrace
  have hle : 1 ≤ Fintype.card n := Fintype.card_pos_iff.mpr ‹Nonempty n›
  apply Nat.cast_injective (R := ℝ)
  rw [Nat.cast_sub hle]
  simpa using htrace

