/-- A contrast whose column Gram is the centering projection has zero row sums. -/
theorem orthogonalContrast_mulVec_one_eq_zero_of_centering
    {df : Type*} [Fintype df]
    (C : Matrix df n ℝ)
    (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n)) :
    C *ᵥ (fun _ : n => (1 : ℝ)) = 0 := by
  classical
  have hquad :
      (C *ᵥ (fun _ : n => (1 : ℝ))) ⬝ᵥ
          (C *ᵥ (fun _ : n => (1 : ℝ))) = 0 := by
    calc
      (C *ᵥ (fun _ : n => (1 : ℝ))) ⬝ᵥ
          (C *ᵥ (fun _ : n => (1 : ℝ)))
          = (fun _ : n => (1 : ℝ)) ⬝ᵥ
              (Cᵀ *ᵥ (C *ᵥ (fun _ : n => (1 : ℝ)))) := by
                have hdot := Matrix.dotProduct_mulVec
                  (fun _ : n => (1 : ℝ)) Cᵀ
                  (C *ᵥ (fun _ : n => (1 : ℝ)))
                simpa [vecMul_eq_mulVec_transpose, Matrix.transpose_transpose] using
                  hdot.symm
      _ = (fun _ : n => (1 : ℝ)) ⬝ᵥ
            ((Cᵀ * C) *ᵥ (fun _ : n => (1 : ℝ))) := by
              rw [Matrix.mulVec_mulVec]
      _ = (fun _ : n => (1 : ℝ)) ⬝ᵥ
            (sampleCenteringMatrix (n := n) *ᵥ (fun _ : n => (1 : ℝ))) := by
              rw [hcenter]
      _ = 0 := by
              simp
  exact dotProduct_self_eq_zero.mp hquad

