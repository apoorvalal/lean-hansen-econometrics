/-- Deterministic full-Gram nonsingularity certificate for the standard
coordinate Schur block.

If the nuisance Gram matrix is nonsingular and the residualized first-column
quadratic form is nonzero, then the full `YᵀY` Gram matrix is nonsingular.
This is the algebraic bridge used to reduce the remaining standard Gaussian
certificate from full/nuisance nonsingularity to nuisance nonsingularity plus
the already-proved chi-square residual law. -/
theorem matrixCrossProduct_standardCoordinate_nonsingular_of_nuisance_nonsingular_residual_ne
    {r : Type*} [Fintype r] [DecidableEq r]
    (Y : Matrix n (Sum Unit r) ℝ)
    (hnuisance : Nonempty (Invertible
      ((standardCoordinateRestColumns (n := n) Y)ᵀ *
        standardCoordinateRestColumns (n := n) Y)))
    (hresid :
      (standardCoordinateFirstColumn (n := n) Y : n → ℝ) ⬝ᵥ
          (gaussianResidualProjection (n := n)
              (standardCoordinateRestColumns (n := n) Y) *ᵥ
            (standardCoordinateFirstColumn (n := n) Y : n → ℝ)) ≠ 0) :
    Nonempty (Invertible (matrixCrossProduct Y)) := by
  classical
  rcases hnuisance with ⟨instD⟩
  letI : Invertible ((standardCoordinateRestColumns (n := n) Y)ᵀ *
      standardCoordinateRestColumns (n := n) Y) := instD
  let z : n → ℝ := (standardCoordinateFirstColumn (n := n) Y : n → ℝ)
  let X : Matrix n r ℝ := standardCoordinateRestColumns (n := n) Y
  let A : Matrix Unit Unit ℝ := fun _ _ => z ⬝ᵥ z
  let B : Matrix Unit r ℝ := fun _ j => z ⬝ᵥ fun i : n => X i j
  let C : Matrix r Unit ℝ := fun j _ => (fun i : n => X i j) ⬝ᵥ z
  let D : Matrix r r ℝ := Xᵀ * X
