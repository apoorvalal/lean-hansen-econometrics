/-- Coordinate covariance of a single normal row. -/
theorem iidNormalRows_covariance_eval_same
    [IsProbabilityMeasure μ] (Y : Ω → Matrix n m ℝ)
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (i : n) (a b : m) :
    cov[fun ω => Y ω i a, fun ω => Y ω i b; μ] = Sigma a b := by
  have heval_a : AEMeasurable (fun x : m → ℝ => x a)
      (rowGaussianLaw mean Sigma) :=
    (measurable_pi_apply (X := fun _ : m => ℝ) a).aemeasurable
  have heval_b : AEMeasurable (fun x : m → ℝ => x b)
      (rowGaussianLaw mean Sigma) :=
    (measurable_pi_apply (X := fun _ : m => ℝ) b).aemeasurable
  have hcov := (hrow i).covariance_fun_comp heval_a heval_b
  rw [hcov]
  exact rowGaussianLaw_covariance_eval mean hSigma a b

