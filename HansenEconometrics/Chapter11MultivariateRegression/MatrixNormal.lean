private theorem congr_quad_nonsingInv_of_inverse_rect
    {q : Type*} [Fintype q] [DecidableEq q]
    (A : Matrix m m ℝ) (T : Matrix m q ℝ) (S : Matrix q m ℝ)
    (x : m → ℝ)
    (hST : S * T = 1) (hTS : T * S = 1) (hA : IsUnit A.det) :
    (Tᵀ *ᵥ x) ⬝ᵥ (((Tᵀ * A * T)⁻¹) *ᵥ (Tᵀ *ᵥ x)) =
      x ⬝ᵥ (A⁻¹ *ᵥ x) := by
  have htr : Sᵀ * Tᵀ = 1 := by
    rw [← Matrix.transpose_mul, hTS, Matrix.transpose_one]
  rw [nonsingInv_conjugate_of_inverse (G := A) (T := T) (S := S) hST hTS hA]
  calc
    (Tᵀ *ᵥ x) ⬝ᵥ ((S * A⁻¹ * Sᵀ) *ᵥ (Tᵀ *ᵥ x))
        = x ⬝ᵥ (((Tᵀ)ᵀ * (S * A⁻¹ * Sᵀ) * Tᵀ) *ᵥ x) := by
            exact quadraticForm_mulVec_eq_pullback_rect
              (B := Tᵀ) (A := S * A⁻¹ * Sᵀ) x
    _ = x ⬝ᵥ (A⁻¹ *ᵥ x) := by
        have hmat : (Tᵀ)ᵀ * (S * A⁻¹ * Sᵀ) * Tᵀ = A⁻¹ := by
          calc
            (Tᵀ)ᵀ * (S * A⁻¹ * Sᵀ) * Tᵀ
                = T * (S * (A⁻¹ * (Sᵀ * Tᵀ))) := by
                    simp [Matrix.transpose_transpose, Matrix.mul_assoc]
            _ = T * (S * (A⁻¹ * 1)) := by rw [htr]
            _ = T * (S * A⁻¹) := by rw [Matrix.mul_one]
            _ = (T * S) * A⁻¹ := by rw [Matrix.mul_assoc]
            _ = 1 * A⁻¹ := by rw [hTS]
            _ = A⁻¹ := by rw [Matrix.one_mul]
