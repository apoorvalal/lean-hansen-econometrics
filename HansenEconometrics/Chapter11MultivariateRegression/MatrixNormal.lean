      HasGaussianLaw
        (fun Y : n → Sum Unit r → ℝ =>
          (fun i : n => Y i (Sum.inl ()),
            fun p : n × r => Y p.1 (Sum.inr p.2))) piLaw := by
    have hmap := hjointRows.map_fun
      (standardCoordinateFirstRestFlatCLM (n := n) (r := r))
    simpa [standardCoordinateFirstRestFlatCLM, Ymat] using hmap
  change
    (fun Y : n → Sum Unit r → ℝ => fun i : n => Y i (Sum.inl ()))
      ⟂ᵢ[piLaw]
    (fun Y : n → Sum Unit r → ℝ => fun p : n × r => Y p.1 (Sum.inr p.2))
  refine hsplit.indepFun_of_covariance_eval ?_
  intro i p
  by_cases hip : i = p.1
  · subst i
    have hcov := iidNormalRows_covariance_eval_same
      (μ := piLaw) (Y := Ymat) (mean := (0 : Sum Unit r → ℝ))
      (hSigma := Matrix.PosSemidef.one) hrow p.1
      (Sum.inl ()) (Sum.inr p.2)
    simpa [Ymat] using hcov
  · have hcov := iidNormalRows_covariance_eval_ne
      (μ := piLaw) (Y := Ymat) (mean := (0 : Sum Unit r → ℝ))
      (Sigma := (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ))
      hrow hIndRows hip (Sum.inl ()) (Sum.inr p.2)
    simpa [Ymat] using hcov

