    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hY : HasLaw Y (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma) μ)
    (hmap : (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma).map
        (fun Y : Matrix n m ℝ => sampleContrastRows (n := n) C Y) =
      iidMatrixGaussianLaw (n := df) (m := m) (0 : m → ℝ) Sigma) :
    HasLaw (fun ω => sampleContrastRows (n := n) C (Y ω))
      (iidMatrixGaussianLaw (n := df) (m := m) (0 : m → ℝ) Sigma) μ := by
  let hC : HasLaw (fun Y : Matrix n m ℝ => sampleContrastRows (n := n) C Y)
      (iidMatrixGaussianLaw (n := df) (m := m) (0 : m → ℝ) Sigma)
      (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma) :=
    ⟨by
      change AEMeasurable (fun Y : Matrix n m ℝ => C * Y)
        (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma)
      fun_prop,
      hmap⟩
  simpa [Function.comp_def] using hC.comp hY

