      ((chiSquared (Fintype.card dfidx - Fintype.card m + 1)).map
        fun x => (α ⬝ᵥ (Sigma⁻¹ *ᵥ α))⁻¹ * x) μ := by
  classical
  have hWishart :
      (wishartLaw (n := dfidx) Sigma).map
          (fun W : Matrix m m ℝ => Tᵀ * W * T) =
        wishartLaw (n := dfidx)
          (1 : Matrix (Sum Unit r) (Sum Unit r) ℝ) :=
    wishartLaw_congr_map_of_iidMatrixGaussianLaw_map
      (n := dfidx) (m := m) (q := Sum Unit r)
