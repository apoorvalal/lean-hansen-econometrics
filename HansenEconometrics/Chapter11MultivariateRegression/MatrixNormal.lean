/-- Orthogonal coordinate changes preserve Hansen's raw inverse-Wishart scalar
form, once the realized Wishart matrix is nonsingular.

This is the deterministic algebra part of the whitening/coordinate-congruence
step for Theorem 11.11.  The remaining probabilistic step is to show that the
Wishart law itself transports under the corresponding coordinate map. -/
theorem inverseWishartLinearForm_orthogonal_congr
    (Q : Matrix m m ℝ) (α : m → ℝ) (W : Matrix m m ℝ)
    (hW : IsUnit W.det)
    (hQTQ : Qᵀ * Q = 1) (hQQT : Q * Qᵀ = 1) :
    inverseWishartLinearForm (Qᵀ *ᵥ α) (Qᵀ * W * Q) =
      inverseWishartLinearForm α W := by
  unfold inverseWishartLinearForm
  have hWQuad :
      (Qᵀ *ᵥ α) ⬝ᵥ (((Qᵀ * W * Q)⁻¹ * Qᵀ) *ᵥ α) =
        α ⬝ᵥ (W⁻¹ *ᵥ α) := by
    simpa [Matrix.mulVec_mulVec] using
      congr_quad_nonsingInv_of_inverse W Q Qᵀ α hQTQ hQQT hW
  rw [Matrix.mulVec_mulVec, hWQuad]

