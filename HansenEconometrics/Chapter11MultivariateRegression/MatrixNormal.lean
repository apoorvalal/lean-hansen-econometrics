      iidMatrixGaussianLaw (n := n) (m := q) (0 : q → ℝ) Sigma') :
    (wishartLaw (n := n) Sigma).map
        (fun W : Matrix m m ℝ => Tᵀ * W * T) =
      wishartLaw (n := n) Sigma' := by
  classical
  let Ylaw : Measure (Matrix n m ℝ) :=
    iidMatrixGaussianLaw (n := n) (m := m) (0 : m → ℝ) Sigma
  let Ymap : Matrix n m ℝ → Matrix n q ℝ := fun Y => Y * T
  let Wmap : Matrix m m ℝ → Matrix q q ℝ := fun W => Tᵀ * W * T
  have hCross : AEMeasurable (matrixCrossProduct (n := n) (m := m)) Ylaw := by
    change AEMeasurable (fun Y : Matrix n m ℝ => Yᵀ * Y) Ylaw
    fun_prop
  have hYmapAe : AEMeasurable Ymap Ylaw := by
    dsimp [Ymap]
    fun_prop
  have hWmap :
      AEMeasurable Wmap
        (Ylaw.map (matrixCrossProduct (n := n) (m := m))) := by
    dsimp [Wmap]
    fun_prop
  have hCrossTarget :
      AEMeasurable (matrixCrossProduct (n := n) (m := q)) (Ylaw.map Ymap) := by
    rw [show Ylaw.map Ymap =
      iidMatrixGaussianLaw (n := n) (m := q) (0 : q → ℝ) Sigma' by
        simpa [Ylaw, Ymap] using hYmap]
    change AEMeasurable (fun Y : Matrix n q ℝ => Yᵀ * Y)
      (iidMatrixGaussianLaw (n := n) (m := q) (0 : q → ℝ) Sigma')
    fun_prop
  calc
    (wishartLaw (n := n) Sigma).map
        (fun W : Matrix m m ℝ => Tᵀ * W * T)
        = (Ylaw.map (matrixCrossProduct (n := n) (m := m))).map Wmap := by
            rfl
    _ = Ylaw.map (fun Y : Matrix n m ℝ =>
          Wmap (matrixCrossProduct (n := n) (m := m) Y)) := by
            simpa [Function.comp_def] using
              AEMeasurable.map_map_of_aemeasurable hWmap hCross
    _ = Ylaw.map (fun Y : Matrix n m ℝ =>
          matrixCrossProduct (n := n) (m := q) (Ymap Y)) := by
            refine Measure.map_congr ?_
            filter_upwards with Y
            simp [Ymap, Wmap, matrixCrossProduct, Matrix.transpose_mul,
