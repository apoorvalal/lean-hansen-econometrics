/-- Rows obtained from a fixed contrast matrix. -/
noncomputable def sampleContrastRows
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) (Y : n → m → ℝ) :
    Matrix df m ℝ :=
  C * sampleRowMatrix Y

omit [DecidableEq n] [DecidableEq m] in
/-- Continuous-linear-map form of the row sample mean. -/
private noncomputable def sampleMeanCLM :
    (n → m → ℝ) →L[ℝ] (m → ℝ) :=
  { toFun := fun Y a => (Fintype.card n : ℝ)⁻¹ * ∑ i : n, Y i a
    map_add' := by
      intro Y Z
      ext a
      simp [Pi.add_apply, Finset.sum_add_distrib, mul_add]
    map_smul' := by
      intro c Y
      ext a
      calc
        (Fintype.card n : ℝ)⁻¹ * ∑ i : n, c * Y i a
            = (Fintype.card n : ℝ)⁻¹ * (c * ∑ i : n, Y i a) := by
                rw [← Finset.mul_sum]
        _ = c * ((Fintype.card n : ℝ)⁻¹ * ∑ i : n, Y i a) := by
                ring }

omit [Fintype m] [DecidableEq n] [DecidableEq m] in
@[simp]
private theorem sampleMeanCLM_apply (Y : n → m → ℝ) :
    sampleMeanCLM (n := n) (m := m) Y = sampleMeanMatrix Y := by
  ext a
  simp [sampleMeanCLM, sampleMeanMatrix, smul_eq_mul]

omit [DecidableEq n] [DecidableEq m] in
/-- Continuous-linear-map form of fixed row contrasts. -/
private noncomputable def contrastRowsCLM
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) :
    (n → m → ℝ) →L[ℝ] (df → m → ℝ) :=
  { toFun := fun Y r a => ∑ i : n, C r i * Y i a
    map_add' := by
      intro Y Z
      ext r a
      simp [Pi.add_apply, mul_add, Finset.sum_add_distrib]
    map_smul' := by
      intro c Y
      ext r a
      calc
        ∑ x : n, C r x * (c * Y x a)
            = ∑ x : n, c * (C r x * Y x a) := by
                refine Finset.sum_congr rfl ?_
                intro x _
                ring
        _ = c * ∑ x : n, C r x * Y x a := by
                rw [Finset.mul_sum] }

omit [Fintype m] [DecidableEq n] [DecidableEq m] in
@[simp]
private theorem contrastRowsCLM_apply
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) (Y : n → m → ℝ) :
    contrastRowsCLM (n := n) (m := m) C Y =
      sampleContrastRows (n := n) C Y := by
  ext r a
  simp [contrastRowsCLM, sampleContrastRows, sampleRowMatrix, Matrix.mul_apply]

omit [DecidableEq n] [DecidableEq m] in
/-- Flattening fixed contrast rows into a single finite coordinate family. -/
private noncomputable def contrastRowsFlatCLM
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) :
    (n → m → ℝ) →L[ℝ] (df × m → ℝ) :=
  { toFun := fun Y p => ∑ i : n, C p.1 i * Y i p.2
    map_add' := by
      intro Y Z
      ext p
      simp [Pi.add_apply, mul_add, Finset.sum_add_distrib]
    map_smul' := by
      intro c Y
      ext p
      calc
        ∑ i : n, C p.1 i * (c * Y i p.2)
            = ∑ i : n, c * (C p.1 i * Y i p.2) := by
                refine Finset.sum_congr rfl ?_
                intro i _
                ring
        _ = c * ∑ i : n, C p.1 i * Y i p.2 := by
                rw [Finset.mul_sum] }

omit [Fintype m] [DecidableEq n] [DecidableEq m] in
@[simp]
private theorem contrastRowsFlatCLM_apply
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) (Y : n → m → ℝ) :
    contrastRowsFlatCLM (n := n) (m := m) C Y =
      fun p : df × m => sampleContrastRows (n := n) C Y p.1 p.2 := by
  ext p
  simp [contrastRowsFlatCLM, sampleContrastRows, sampleRowMatrix, Matrix.mul_apply]

omit [DecidableEq n] [DecidableEq m] in
/-- Joint sample-mean/contrast map used for Gaussian independence arguments. -/
private noncomputable def sampleMeanContrastFlatCLM
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) :
    (n → m → ℝ) →L[ℝ] ((m → ℝ) × (df × m → ℝ)) :=
  (sampleMeanCLM (n := n) (m := m)).prod
    (contrastRowsFlatCLM (n := n) (m := m) C)

omit [Fintype m] [DecidableEq n] [DecidableEq m] in
@[simp]
private theorem sampleMeanContrastFlatCLM_apply
    {df : Type*} [Fintype df] (C : Matrix df n ℝ) (Y : n → m → ℝ) :
    sampleMeanContrastFlatCLM (n := n) (m := m) C Y =
      (sampleMeanMatrix Y,
        fun p : df × m => sampleContrastRows (n := n) C Y p.1 p.2) := by
  apply Prod.ext
  · exact sampleMeanCLM_apply (n := n) (m := m) Y
  · exact contrastRowsFlatCLM_apply (n := n) (m := m) C Y

