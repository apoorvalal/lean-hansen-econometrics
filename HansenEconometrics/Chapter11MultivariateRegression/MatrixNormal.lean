    simpa [id] using (HasLaw.id (μ := Ylaw))
  have hRest : HasLaw Rest Xlaw Ylaw := by
    simpa [Ylaw, Xlaw, Rest] using
      standardCoordinateRestColumns_hasLaw_iidMatrixGaussianLaw
        (Ω := Matrix n (Sum Unit r) ℝ) (μ := Ylaw)
        (n := n) (r := r)
        (Y := fun Y : Matrix n (Sum Unit r) ℝ => Y) hId
