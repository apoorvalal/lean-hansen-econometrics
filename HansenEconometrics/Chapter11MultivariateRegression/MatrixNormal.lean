  let q : ℝ := d ⬝ᵥ Sigma⁻¹ *ᵥ d
  change (Fintype.card n : ℝ) * q = c * (c * q)
  calc
    (Fintype.card n : ℝ) * q = (c * c) * q := by rw [hc_sq]
    _ = c * (c * q) := by ring

