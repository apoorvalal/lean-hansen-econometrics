/-- The totalized residual projection is a.e. measurable as a function of the
nuisance design matrix. -/
private theorem gaussianResidualProjection_aemeasurable
    {r : Type*} [Fintype r] [DecidableEq r]
    (Xlaw : Measure (Matrix n r ℝ)) :
    AEMeasurable (fun X : Matrix n r ℝ => gaussianResidualProjection (n := n) X)
      Xlaw := by
  change AEMeasurable
    (fun X : Matrix n r ℝ =>
      (1 : Matrix n n ℝ) - X * ((Xᵀ * X)⁻¹) * Xᵀ) Xlaw
  have hGram : AEStronglyMeasurable (fun X : Matrix n r ℝ => Xᵀ * X) Xlaw := by
    fun_prop
  have hInv : AEStronglyMeasurable
      (fun X : Matrix n r ℝ => (Xᵀ * X)⁻¹) Xlaw :=
    aestronglyMeasurable_matrix_inv hGram
  have hProjTerm : AEStronglyMeasurable
      (fun X : Matrix n r ℝ => X * ((Xᵀ * X)⁻¹) * Xᵀ) Xlaw := by
    fun_prop
  exact (aestronglyMeasurable_const.sub hProjTerm).aemeasurable

