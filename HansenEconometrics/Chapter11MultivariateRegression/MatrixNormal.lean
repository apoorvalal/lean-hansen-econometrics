/-- Any inverse-Wishart linear-form law can be obtained as the push-forward of
the matrix law through Hansen's scalar map. -/
theorem inverseWishartLinearForm_hasLaw_map
    (W : Ω → Matrix m m ℝ) (Wlaw : Measure (Matrix m m ℝ)) (α : m → ℝ)
    (hW : HasLaw W Wlaw μ) :
    HasLaw (fun ω => inverseWishartLinearForm α (W ω))
      (Wlaw.map (inverseWishartLinearForm α)) μ := by
  have hInv : AEStronglyMeasurable (fun W : Matrix m m ℝ => W⁻¹) Wlaw :=
    aestronglyMeasurable_matrix_inv aestronglyMeasurable_id
  have hVec : AEStronglyMeasurable (fun W : Matrix m m ℝ => W⁻¹ *ᵥ α) Wlaw :=
    (Continuous.matrix_mulVec continuous_fst continuous_snd).comp_aestronglyMeasurable
      (hInv.prodMk aestronglyMeasurable_const)
  have hQuad : AEStronglyMeasurable
      (fun W : Matrix m m ℝ => α ⬝ᵥ (W⁻¹ *ᵥ α)) Wlaw := by
    have hsum : AEStronglyMeasurable
        (∑ i, fun W : Matrix m m ℝ => α i * (W⁻¹ *ᵥ α) i) Wlaw :=
      Finset.aestronglyMeasurable_sum Finset.univ
      (fun i _ => aestronglyMeasurable_const.mul
        ((continuous_apply i).comp_aestronglyMeasurable hVec))
    change AEStronglyMeasurable
      (fun W : Matrix m m ℝ => ∑ i, α i * (W⁻¹ *ᵥ α) i) Wlaw
    convert hsum using 1
    ext W
    simp only [Finset.sum_apply]
  let hmap : HasLaw (inverseWishartLinearForm α)
      (Wlaw.map (inverseWishartLinearForm α)) Wlaw :=
    ⟨by
      change AEMeasurable
        (fun W : Matrix m m ℝ => (α ⬝ᵥ (W⁻¹ *ᵥ α))⁻¹) Wlaw
      exact hQuad.aemeasurable.inv, rfl⟩
  exact hmap.comp hW

/-- Inverse-Wishart scalar-form chi-square law from a proved push-forward
identity. This is the reusable bridge for Hansen Theorem 11.11: once the
inverse-Wishart matrix law is known and its scalar map is identified with the
right chi-square law, the random-variable statement follows. -/
theorem inverseWishartLinearForm_hasLaw_chiSquared_of_map_eq
    (W : Ω → Matrix m m ℝ) (Wlaw : Measure (Matrix m m ℝ))
    (α : m → ℝ) (df : ℕ)
    (hW : HasLaw W Wlaw μ)
    (hmap : Wlaw.map (inverseWishartLinearForm α) = chiSquared df) :
    HasLaw (fun ω => inverseWishartLinearForm α (W ω)) (chiSquared df) μ := by
  rw [← hmap]
  exact inverseWishartLinearForm_hasLaw_map W Wlaw α hW

private theorem inverseWishartLinearForm_aemeasurable
    (Wlaw : Measure (Matrix m m ℝ)) (α : m → ℝ) :
    AEMeasurable (inverseWishartLinearForm α) Wlaw := by
  have hId : HasLaw (fun W : Matrix m m ℝ => W) Wlaw Wlaw :=
    HasLaw.id
  exact (inverseWishartLinearForm_hasLaw_map
    (Ω := Matrix m m ℝ) (μ := Wlaw)
    (fun W : Matrix m m ℝ => W) Wlaw α hId).aemeasurable

/-- Hansen Theorem 11.11 scaled inverse-Wishart scalar form as a push-forward
of the matrix law. -/
theorem inverseWishartScaledLinearForm_hasLaw_map
    (W : Ω → Matrix m m ℝ) (Wlaw : Measure (Matrix m m ℝ))
    (Sigma : Matrix m m ℝ) (α : m → ℝ)
    (hW : HasLaw W Wlaw μ) :
    HasLaw (fun ω => inverseWishartScaledLinearForm Sigma α (W ω))
      (Wlaw.map (inverseWishartScaledLinearForm Sigma α)) μ := by
  let c : ℝ := (α ⬝ᵥ (Sigma⁻¹ *ᵥ α))⁻¹
  let hmap : HasLaw (inverseWishartScaledLinearForm Sigma α)
      (Wlaw.map (inverseWishartScaledLinearForm Sigma α)) Wlaw :=
    ⟨by
      change AEMeasurable (fun W : Matrix m m ℝ =>
        (α ⬝ᵥ (Sigma⁻¹ *ᵥ α)) * inverseWishartLinearForm α W) Wlaw
      exact (inverseWishartLinearForm_aemeasurable Wlaw α).const_mul
        (α ⬝ᵥ (Sigma⁻¹ *ᵥ α)), rfl⟩
  exact hmap.comp hW

/-- Hansen Theorem 11.11 scaled inverse-Wishart chi-square bridge.

The map identity is the remaining Schur-complement/inverse-Wishart content; the
random-variable law then follows without restating the measurability proof. -/
theorem inverseWishartScaledLinearForm_hasLaw_chiSquared_of_map_eq
    (W : Ω → Matrix m m ℝ) (Wlaw : Measure (Matrix m m ℝ))
    (Sigma : Matrix m m ℝ) (α : m → ℝ) (df : ℕ)
    (hW : HasLaw W Wlaw μ)
    (hmap : Wlaw.map (inverseWishartScaledLinearForm Sigma α) = chiSquared df) :
    HasLaw (fun ω => inverseWishartScaledLinearForm Sigma α (W ω)) (chiSquared df) μ := by
  rw [← hmap]
  exact inverseWishartScaledLinearForm_hasLaw_map W Wlaw Sigma α hW

/-- Independent random-parameter push-forward bridge.

If `A` and `B` are independent, `B ∼ βlaw`, and every fixed-parameter
push-forward `b ↦ F (a,b)` has the same law `ρ`, then the random-parameter
statistic `F (A,B)` also has law `ρ`. This is the measure-theoretic bridge
needed to turn fixed-`α` inverse-Wishart scalar laws into the random-`α`
Hotelling component. -/
theorem hasLaw_of_indepFun_forall_fixed_map_eq
    {α β γ : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    {A : Ω → α} {B : Ω → β}
    {αlaw : Measure α} {βlaw : Measure β} {ρ : Measure γ}
    [SFinite βlaw] [SFinite ρ] [IsProbabilityMeasure αlaw]
    (F : α × β → γ)
    (hA : HasLaw A αlaw μ) (hB : HasLaw B βlaw μ)
    (hInd : A ⟂ᵢ[μ] B)
    (hF : Measurable F)
    (hF_fixed : ∀ a : α, Measurable fun b : β => F (a, b))
    (hfixed : ∀ a : α, βlaw.map (fun b : β => F (a, b)) = ρ) :
    HasLaw (fun ω => F (A ω, B ω)) ρ μ := by
  haveI : IsProbabilityMeasure μ := hA.isProbabilityMeasure
  have hPair :
      HasLaw (fun ω => (A ω, B ω)) (αlaw.prod βlaw) μ := by
    refine ⟨hA.aemeasurable.prodMk hB.aemeasurable, ?_⟩
    rw [(indepFun_iff_map_prod_eq_prod_map_map hA.aemeasurable hB.aemeasurable).1 hInd,
      hA.map_eq, hB.map_eq]
  have hMap : HasLaw F ρ (αlaw.prod βlaw) := by
    refine ⟨hF.aemeasurable, ?_⟩
    ext s hs
    rw [Measure.map_apply hF hs, Measure.prod_apply (hF hs)]
    have hsection : ∀ a : α,
        βlaw ((Prod.mk a) ⁻¹' (F ⁻¹' s)) = ρ s := by
      intro a
      calc
        βlaw ((Prod.mk a) ⁻¹' (F ⁻¹' s))
            = βlaw ((fun b : β => F (a, b)) ⁻¹' s) := rfl
        _ = βlaw.map (fun b : β => F (a, b)) s := by
            rw [← Measure.map_apply (hF_fixed a) hs]
        _ = ρ s := by rw [hfixed a]
    simp_rw [hsection]
    rw [lintegral_const]
    simp
  simpa [Function.comp_def] using hMap.comp hPair

/-- A.e.-measurable version of
`hasLaw_of_indepFun_forall_fixed_map_eq`.

This is the version used by inverse-Wishart scalar forms, since total matrix
inverse is available in the repo through a.e. measurability. -/
theorem hasLaw_of_indepFun_forall_fixed_map_eq_ae
    {α β γ : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    {A : Ω → α} {B : Ω → β}
    {αlaw : Measure α} {βlaw : Measure β} {ρ : Measure γ}
    [SFinite βlaw] [IsProbabilityMeasure αlaw]
    (F : α × β → γ)
    (hA : HasLaw A αlaw μ) (hB : HasLaw B βlaw μ)
    (hInd : A ⟂ᵢ[μ] B)
    (hF : AEMeasurable F (αlaw.prod βlaw))
    (hF_fixed : ∀ a : α, AEMeasurable (fun b : β => F (a, b)) βlaw)
    (hfixed : ∀ a : α, βlaw.map (fun b : β => F (a, b)) = ρ) :
    HasLaw (fun ω => F (A ω, B ω)) ρ μ := by
  haveI : IsProbabilityMeasure μ := hA.isProbabilityMeasure
  have hPair :
      HasLaw (fun ω => (A ω, B ω)) (αlaw.prod βlaw) μ := by
    refine ⟨hA.aemeasurable.prodMk hB.aemeasurable, ?_⟩
    rw [(indepFun_iff_map_prod_eq_prod_map_map hA.aemeasurable hB.aemeasurable).1 hInd,
      hA.map_eq, hB.map_eq]
  have hMap : HasLaw F ρ (αlaw.prod βlaw) := by
    refine ⟨hF, ?_⟩
    apply Measure.ext_of_lintegral
    intro g hg
    calc
      ∫⁻ y, g y ∂Measure.map F (αlaw.prod βlaw)
          = ∫⁻ z, g (F z) ∂(αlaw.prod βlaw) := by
              rw [lintegral_map' hg.aemeasurable hF]
      _ = ∫⁻ a, ∫⁻ b, g (F (a, b)) ∂βlaw ∂αlaw := by
              rw [lintegral_prod
                (fun z : α × β => g (F z)) (hg.comp_aemeasurable hF)]
      _ = ∫⁻ a, ∫⁻ y, g y ∂ρ ∂αlaw := by
              congr with a
              calc
                ∫⁻ b, g (F (a, b)) ∂βlaw
                    = ∫⁻ y, g y ∂βlaw.map (fun b : β => F (a, b)) := by
                        rw [lintegral_map' hg.aemeasurable (hF_fixed a)]
                _ = ∫⁻ y, g y ∂ρ := by rw [hfixed a]
      _ = ∫⁻ y, g y ∂ρ := by
              rw [lintegral_const]
              simp
  simpa [Function.comp_def] using hMap.comp hPair

/-- A.e. fixed-law version of
`hasLaw_of_indepFun_forall_fixed_map_eq_ae`.

This is the right bridge when the fixed-parameter law is only meaningful off a
null set of parameters, as in the inverse-Wishart scalar form with random
`α`: the fixed `α = 0` map is degenerate, but a nondegenerate Gaussian
parameter avoids that point almost surely. -/
theorem hasLaw_of_indepFun_ae_fixed_map_eq_ae
    {α β γ : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    {A : Ω → α} {B : Ω → β}
    {αlaw : Measure α} {βlaw : Measure β} {ρ : Measure γ}
    [SFinite βlaw] [IsProbabilityMeasure αlaw]
    (F : α × β → γ)
    (hA : HasLaw A αlaw μ) (hB : HasLaw B βlaw μ)
    (hInd : A ⟂ᵢ[μ] B)
    (hF : AEMeasurable F (αlaw.prod βlaw))
    (hF_fixed : ∀ a : α, AEMeasurable (fun b : β => F (a, b)) βlaw)
    (hfixed : ∀ᵐ a ∂αlaw, βlaw.map (fun b : β => F (a, b)) = ρ) :
    HasLaw (fun ω => F (A ω, B ω)) ρ μ := by
  haveI : IsProbabilityMeasure μ := hA.isProbabilityMeasure
  have hPair :
      HasLaw (fun ω => (A ω, B ω)) (αlaw.prod βlaw) μ := by
    refine ⟨hA.aemeasurable.prodMk hB.aemeasurable, ?_⟩
    rw [(indepFun_iff_map_prod_eq_prod_map_map hA.aemeasurable hB.aemeasurable).1 hInd,
      hA.map_eq, hB.map_eq]
  have hMap : HasLaw F ρ (αlaw.prod βlaw) := by
    refine ⟨hF, ?_⟩
    apply Measure.ext_of_lintegral
    intro g hg
    calc
      ∫⁻ y, g y ∂Measure.map F (αlaw.prod βlaw)
          = ∫⁻ z, g (F z) ∂(αlaw.prod βlaw) := by
              rw [lintegral_map' hg.aemeasurable hF]
      _ = ∫⁻ a, ∫⁻ b, g (F (a, b)) ∂βlaw ∂αlaw := by
              rw [lintegral_prod
                (fun z : α × β => g (F z)) (hg.comp_aemeasurable hF)]
      _ = ∫⁻ a, ∫⁻ y, g y ∂ρ ∂αlaw := by
              refine lintegral_congr_ae ?_
              filter_upwards [hfixed] with a ha
              calc
                ∫⁻ b, g (F (a, b)) ∂βlaw
                    = ∫⁻ y, g y ∂βlaw.map (fun b : β => F (a, b)) := by
                        rw [lintegral_map' hg.aemeasurable (hF_fixed a)]
                _ = ∫⁻ y, g y ∂ρ := by rw [ha]
      _ = ∫⁻ y, g y ∂ρ := by
              rw [lintegral_const]
              simp
  simpa [Function.comp_def] using hMap.comp hPair

/-- Joint law version of
`hasLaw_of_indepFun_ae_fixed_map_eq_ae`.

If `A` is independent of `B` and, for `αlaw`-almost every parameter `a`, the
conditional push-forward of `B` through `F(a, ·)` is the same law `ρ`, then the
pair `(A, F(A,B))` has product law `αlaw × ρ`.  This is the reusable
conditional-law-to-independence bridge needed for Hotelling's random
inverse-Wishart component. -/
theorem hasLaw_prodMk_of_indepFun_ae_fixed_map_eq_ae
    {α β γ : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    {A : Ω → α} {B : Ω → β}
    {αlaw : Measure α} {βlaw : Measure β} {ρ : Measure γ}
    [SFinite βlaw] [SFinite ρ] [IsProbabilityMeasure αlaw]
    (F : α × β → γ)
    (hA : HasLaw A αlaw μ) (hB : HasLaw B βlaw μ)
    (hInd : A ⟂ᵢ[μ] B)
    (hF : AEMeasurable F (αlaw.prod βlaw))
    (hF_fixed : ∀ a : α, AEMeasurable (fun b : β => F (a, b)) βlaw)
    (hfixed : ∀ᵐ a ∂αlaw, βlaw.map (fun b : β => F (a, b)) = ρ) :
    HasLaw (fun ω => (A ω, F (A ω, B ω))) (αlaw.prod ρ) μ := by
  haveI : IsProbabilityMeasure μ := hA.isProbabilityMeasure
  have hPair :
      HasLaw (fun ω => (A ω, B ω)) (αlaw.prod βlaw) μ := by
    refine ⟨hA.aemeasurable.prodMk hB.aemeasurable, ?_⟩
    rw [(indepFun_iff_map_prod_eq_prod_map_map hA.aemeasurable hB.aemeasurable).1 hInd,
      hA.map_eq, hB.map_eq]
  let G : α × β → α × γ := fun z => (z.1, F z)
  have hG : AEMeasurable G (αlaw.prod βlaw) := by
    dsimp [G]
    exact measurable_fst.aemeasurable.prodMk hF
  have hMap : HasLaw G (αlaw.prod ρ) (αlaw.prod βlaw) := by
    refine ⟨hG, ?_⟩
    apply Measure.ext_of_lintegral
    intro g hg
    calc
      ∫⁻ y, g y ∂Measure.map G (αlaw.prod βlaw)
          = ∫⁻ z, g (G z) ∂(αlaw.prod βlaw) := by
              rw [lintegral_map' hg.aemeasurable hG]
      _ = ∫⁻ a, ∫⁻ b, g (a, F (a, b)) ∂βlaw ∂αlaw := by
              rw [lintegral_prod
                (fun z : α × β => g (G z)) (hg.comp_aemeasurable hG)]
      _ = ∫⁻ a, ∫⁻ y, g (a, y) ∂ρ ∂αlaw := by
              refine lintegral_congr_ae ?_
              filter_upwards [hfixed] with a ha
              have hg_a : AEMeasurable (fun y : γ => g (a, y)) ρ := by
                exact hg.comp_aemeasurable (aemeasurable_const.prodMk aemeasurable_id)
              have hg_a_map :
                  AEMeasurable (fun y : γ => g (a, y))
                    (βlaw.map fun b : β => F (a, b)) := by
                rw [ha]
                exact hg_a
              calc
                ∫⁻ b, g (a, F (a, b)) ∂βlaw
                    = ∫⁻ y, g (a, y) ∂βlaw.map (fun b : β => F (a, b)) := by
                        rw [lintegral_map' hg_a_map (hF_fixed a)]
                _ = ∫⁻ y, g (a, y) ∂ρ := by rw [ha]
      _ = ∫⁻ y, g y ∂(αlaw.prod ρ) := by
              rw [lintegral_prod g hg.aemeasurable]
  simpa [Function.comp_def, G] using hMap.comp hPair

/-- Independence version of
`hasLaw_of_indepFun_ae_fixed_map_eq_ae`.

The same conditional fixed-map law that gives the marginal law of `F(A,B)`
also proves that `F(A,B)` is independent of the parameter `A`. -/
theorem indepFun_of_indepFun_ae_fixed_map_eq_ae
    {α β γ : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    {A : Ω → α} {B : Ω → β}
    {αlaw : Measure α} {βlaw : Measure β} {ρ : Measure γ}
    [SFinite βlaw] [SFinite ρ] [IsProbabilityMeasure αlaw]
    (F : α × β → γ)
    (hA : HasLaw A αlaw μ) (hB : HasLaw B βlaw μ)
    (hInd : A ⟂ᵢ[μ] B)
    (hF : AEMeasurable F (αlaw.prod βlaw))
    (hF_fixed : ∀ a : α, AEMeasurable (fun b : β => F (a, b)) βlaw)
    (hfixed : ∀ᵐ a ∂αlaw, βlaw.map (fun b : β => F (a, b)) = ρ) :
    A ⟂ᵢ[μ] fun ω => F (A ω, B ω) := by
  haveI : IsProbabilityMeasure μ := hA.isProbabilityMeasure
  have hV : HasLaw (fun ω => F (A ω, B ω)) ρ μ :=
    hasLaw_of_indepFun_ae_fixed_map_eq_ae
      (F := F) hA hB hInd hF hF_fixed hfixed
  have hPair : HasLaw (fun ω => (A ω, F (A ω, B ω))) (αlaw.prod ρ) μ :=
    hasLaw_prodMk_of_indepFun_ae_fixed_map_eq_ae
      (F := F) hA hB hInd hF hF_fixed hfixed
  rw [indepFun_iff_map_prod_eq_prod_map_map hA.aemeasurable hV.aemeasurable]
  rw [hPair.map_eq, hA.map_eq, hV.map_eq]

/-- A.e. measurability of Hansen's scaled inverse-Wishart scalar map for fixed
`α`. -/
private theorem inverseWishartScaledLinearForm_aemeasurable
    (Wlaw : Measure (Matrix m m ℝ)) (Sigma : Matrix m m ℝ) (α : m → ℝ) :
    AEMeasurable (inverseWishartScaledLinearForm Sigma α) Wlaw := by
  change AEMeasurable
    (fun W : Matrix m m ℝ =>
      (α ⬝ᵥ (Sigma⁻¹ *ᵥ α)) * inverseWishartLinearForm α W) Wlaw
  exact (inverseWishartLinearForm_aemeasurable Wlaw α).const_mul
    (α ⬝ᵥ (Sigma⁻¹ *ᵥ α))

/-- A.e. measurability of Hansen's scaled inverse-Wishart scalar map jointly in
the parameter vector and Wishart matrix. -/
private theorem inverseWishartScaledLinearForm_prod_aemeasurable
    (Alaw : Measure (m → ℝ)) (Wlaw : Measure (Matrix m m ℝ))
    (Sigma : Matrix m m ℝ) :
    AEMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ =>
        inverseWishartScaledLinearForm Sigma z.1 z.2)
      (Alaw.prod Wlaw) := by
  have hAlpha : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ => z.1) (Alaw.prod Wlaw) :=
    continuous_fst.aestronglyMeasurable
  have hW : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ => z.2) (Alaw.prod Wlaw) :=
    continuous_snd.aestronglyMeasurable
  have hWinv : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ => z.2⁻¹) (Alaw.prod Wlaw) :=
    aestronglyMeasurable_matrix_inv hW
  have hSigmaVec : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ => Sigma⁻¹ *ᵥ z.1)
      (Alaw.prod Wlaw) :=
    (Continuous.matrix_mulVec continuous_fst continuous_snd).comp_aestronglyMeasurable
      (aestronglyMeasurable_const.prodMk hAlpha)
  have hWinvVec : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ => z.2⁻¹ *ᵥ z.1)
      (Alaw.prod Wlaw) :=
    (Continuous.matrix_mulVec continuous_fst continuous_snd).comp_aestronglyMeasurable
      (hWinv.prodMk hAlpha)
  have hScale : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ =>
        z.1 ⬝ᵥ (Sigma⁻¹ *ᵥ z.1)) (Alaw.prod Wlaw) := by
    have hsum : AEStronglyMeasurable
        (∑ i, fun z : (m → ℝ) × Matrix m m ℝ =>
          z.1 i * (Sigma⁻¹ *ᵥ z.1) i) (Alaw.prod Wlaw) :=
      Finset.aestronglyMeasurable_sum Finset.univ
      (fun i _ =>
        ((continuous_apply i).comp_aestronglyMeasurable hAlpha).mul
          ((continuous_apply i).comp_aestronglyMeasurable hSigmaVec))
    change AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ =>
        ∑ i, z.1 i * (Sigma⁻¹ *ᵥ z.1) i) (Alaw.prod Wlaw)
    convert hsum using 1
    ext z
    simp only [Finset.sum_apply]
  have hQuad : AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ =>
        z.1 ⬝ᵥ (z.2⁻¹ *ᵥ z.1)) (Alaw.prod Wlaw) := by
    have hsum : AEStronglyMeasurable
        (∑ i, fun z : (m → ℝ) × Matrix m m ℝ =>
          z.1 i * (z.2⁻¹ *ᵥ z.1) i) (Alaw.prod Wlaw) :=
      Finset.aestronglyMeasurable_sum Finset.univ
      (fun i _ =>
        ((continuous_apply i).comp_aestronglyMeasurable hAlpha).mul
          ((continuous_apply i).comp_aestronglyMeasurable hWinvVec))
    change AEStronglyMeasurable
      (fun z : (m → ℝ) × Matrix m m ℝ =>
        ∑ i, z.1 i * (z.2⁻¹ *ᵥ z.1) i) (Alaw.prod Wlaw)
    convert hsum using 1
    ext z
    simp only [Finset.sum_apply]
  change AEMeasurable
    (fun z : (m → ℝ) × Matrix m m ℝ =>
      (z.1 ⬝ᵥ (Sigma⁻¹ *ᵥ z.1)) *
        (z.1 ⬝ᵥ (z.2⁻¹ *ᵥ z.1))⁻¹) (Alaw.prod Wlaw)
  exact hScale.aemeasurable.mul hQuad.aemeasurable.inv

/-- Random-`α` inverse-Wishart scaled scalar law from fixed-`α` map identities
and independence.

The substantive Wishart content remains the family of fixed-parameter
push-forward identities in `hfixed`; this theorem removes the additional
conditional-law bookkeeping needed when `α` is itself a statistic independent
of the Wishart matrix. -/
theorem inverseWishartScaledLinearForm_hasLaw_of_indep_random_parameter
    (A : Ω → m → ℝ) (W : Ω → Matrix m m ℝ)
    (Alaw : Measure (m → ℝ)) (Wlaw : Measure (Matrix m m ℝ))
    (Sigma : Matrix m m ℝ) (df : ℕ)
    [SFinite Wlaw] [IsProbabilityMeasure Alaw]
    (hA : HasLaw A Alaw μ) (hW : HasLaw W Wlaw μ)
    (hInd : A ⟂ᵢ[μ] W)
    (hfixed : ∀ α : m → ℝ,
      Wlaw.map (inverseWishartScaledLinearForm Sigma α) = chiSquared df) :
    HasLaw (fun ω => inverseWishartScaledLinearForm Sigma (A ω) (W ω))
      (chiSquared df) μ :=
  hasLaw_of_indepFun_forall_fixed_map_eq_ae
    (F := fun z : (m → ℝ) × Matrix m m ℝ =>
      inverseWishartScaledLinearForm Sigma z.1 z.2)
    hA hW hInd
    (inverseWishartScaledLinearForm_prod_aemeasurable Alaw Wlaw Sigma)
    (fun α => inverseWishartScaledLinearForm_aemeasurable Wlaw Sigma α)
    hfixed

/-- Random-`α` inverse-Wishart scaled scalar law from a.e. fixed-`α` map
identities and independence.

This variant allows the fixed inverse-Wishart law to be stated only for
`Alaw`-almost every parameter vector, which is the natural form when the
zero-parameter case is degenerate. -/
theorem inverseWishartScaledLinearForm_hasLaw_of_indep_random_parameter_ae
    (A : Ω → m → ℝ) (W : Ω → Matrix m m ℝ)
    (Alaw : Measure (m → ℝ)) (Wlaw : Measure (Matrix m m ℝ))
    (Sigma : Matrix m m ℝ) (df : ℕ)
    [SFinite Wlaw] [IsProbabilityMeasure Alaw]
    (hA : HasLaw A Alaw μ) (hW : HasLaw W Wlaw μ)
    (hInd : A ⟂ᵢ[μ] W)
    (hfixed : ∀ᵐ α ∂Alaw,
      Wlaw.map (inverseWishartScaledLinearForm Sigma α) = chiSquared df) :
    HasLaw (fun ω => inverseWishartScaledLinearForm Sigma (A ω) (W ω))
      (chiSquared df) μ :=
  hasLaw_of_indepFun_ae_fixed_map_eq_ae
    (F := fun z : (m → ℝ) × Matrix m m ℝ =>
      inverseWishartScaledLinearForm Sigma z.1 z.2)
    hA hW hInd
    (inverseWishartScaledLinearForm_prod_aemeasurable Alaw Wlaw Sigma)
    (fun α => inverseWishartScaledLinearForm_aemeasurable Wlaw Sigma α)
    hfixed

