/-- Applying the centering projection to a row matrix subtracts the row sample mean. -/
theorem sampleCenteringMatrix_mul_eq_centeredSampleMatrix
    (Y : n → m → ℝ) :
    sampleCenteringMatrix (n := n) * sampleRowMatrix Y = centeredSampleMatrix Y := by
  classical
  ext i a
  calc
    (sampleCenteringMatrix (n := n) * sampleRowMatrix Y) i a
        = ∑ x, ((1 : Matrix n n ℝ) i x - (Fintype.card n : ℝ)⁻¹) * Y x a := by
            rw [Matrix.mul_apply]
            refine Finset.sum_congr rfl ?_
            intro x _
            rw [sampleCenteringMatrix, sampleRowMatrix]
            change (((1 : Matrix n n ℝ) -
                (show Matrix n n ℝ from fun _ _ => (Fintype.card n : ℝ)⁻¹)) i x) *
                Y x a =
              (((1 : Matrix n n ℝ) i x - (Fintype.card n : ℝ)⁻¹) * Y x a)
            rw [Matrix.sub_apply]
    _ = ∑ x, ((1 : Matrix n n ℝ) i x * Y x a - (Fintype.card n : ℝ)⁻¹ * Y x a) := by
            refine Finset.sum_congr rfl ?_
            intro x _
            ring
    _ = ∑ x, (1 : Matrix n n ℝ) i x * Y x a -
          ∑ x, (Fintype.card n : ℝ)⁻¹ * Y x a := by
            rw [Finset.sum_sub_distrib]
    _ = Y i a - ∑ x, (Fintype.card n : ℝ)⁻¹ * Y x a := by
            rw [Finset.sum_eq_single i]
            · simp
            · intro b _ hb
              simp [hb.symm]
            · intro hnot
              simp at hnot
    _ = centeredSampleMatrix Y i a := by
            rw [← Finset.mul_sum]
            simp [centeredSampleMatrix, sampleMeanMatrix, smul_eq_mul]

