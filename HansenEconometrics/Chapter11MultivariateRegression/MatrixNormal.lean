/-- Covariance of two fixed contrast-row coordinates from iid normal rows.

The formula is the Kronecker covariance identity behind Hansen Theorem 11.10:
left row contrasts transform the row covariance by `C Cᵀ` and preserve the
within-row covariance `Σ`. -/
theorem sampleContrastRows_covariance_eval
    [IsProbabilityMeasure μ]
    {df : Type*} [Fintype df]
    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ)
    (r s : df) (a b : m) :
    cov[fun ω => sampleContrastRows (n := n) C (Y ω) r a,
        fun ω => sampleContrastRows (n := n) C (Y ω) s b; μ] =
      (C * Cᵀ) r s * Sigma a b := by
  classical
  have hmemL : ∀ i : n, MemLp (fun ω => C r i * Y ω i a) 2 μ := by
    intro i
    exact (iidNormalRows_memLp_eval
      (Y := Y) (mean := mean) (Sigma := Sigma) hrow i a).const_mul _
  have hmemR : ∀ j : n, MemLp (fun ω => C s j * Y ω j b) 2 μ := by
    intro j
    exact (iidNormalRows_memLp_eval
      (Y := Y) (mean := mean) (Sigma := Sigma) hrow j b).const_mul _
  calc
    cov[fun ω => sampleContrastRows (n := n) C (Y ω) r a,
        fun ω => sampleContrastRows (n := n) C (Y ω) s b; μ]
        = cov[fun ω => ∑ i : n, C r i * Y ω i a,
            fun ω => ∑ j : n, C s j * Y ω j b; μ] := by
            simp [sampleContrastRows, sampleRowMatrix, Matrix.mul_apply]
    _ = ∑ i : n, ∑ j : n,
          cov[fun ω => C r i * Y ω i a, fun ω => C s j * Y ω j b; μ] := by
            rw [ProbabilityTheory.covariance_fun_sum_fun_sum hmemL hmemR]
    _ = ∑ i : n, ∑ j : n,
          C r i * C s j * (if i = j then Sigma a b else 0) := by
            refine Finset.sum_congr rfl ?_
            intro i _
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [ProbabilityTheory.covariance_const_mul_left,
              ProbabilityTheory.covariance_const_mul_right]
            by_cases hij : i = j
            · subst j
              rw [if_pos rfl]
              rw [iidNormalRows_covariance_eval_same (Y := Y) (mean := mean)
                (hSigma := hSigma) hrow i a b]
              ring
            · rw [if_neg hij]
              rw [iidNormalRows_covariance_eval_ne (Y := Y) (mean := mean)
                (Sigma := Sigma) hrow hInd hij a b]
              ring
    _ = (C * Cᵀ) r s * Sigma a b := by
            have hinner : ∀ i : n,
                (∑ j : n, C r i * C s j *
                  (if i = j then Sigma a b else 0)) =
                  C r i * C s i * Sigma a b := by
              intro i
              rw [Finset.sum_eq_single i]
              · simp
              · intro j _ hji
                rw [if_neg (Ne.symm hji)]
                ring
              · intro hi
                simp at hi
            calc
              ∑ i : n, ∑ j : n, C r i * C s j *
                  (if i = j then Sigma a b else 0)
                  = ∑ i : n, C r i * C s i * Sigma a b := by
                      refine Finset.sum_congr rfl ?_
                      intro i _
                      exact hinner i
              _ = (∑ i : n, C r i * C s i) * Sigma a b := by
                      rw [Finset.sum_mul]
              _ = (C * Cᵀ) r s * Sigma a b := by
                      simp [Matrix.mul_apply]

