/-- The canonical centering contrast spans exactly the centered row subspace. -/
theorem sampleCenteringEigenContrast_transpose_mul :
    (sampleCenteringEigenContrast (n := n))ᵀ *
        sampleCenteringEigenContrast (n := n) = sampleCenteringMatrix (n := n) := by
  classical
  simpa [sampleCenteringEigenContrast, Matrix.mul_apply, Matrix.transpose_apply] using
    isHermitian_idempotent_eq_sum_one_eigenvectorBasis_outer
