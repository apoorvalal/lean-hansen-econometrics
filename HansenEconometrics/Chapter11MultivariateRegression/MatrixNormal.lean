/-!
# Chapter 11 — matrix-normal and Wishart wrappers

This file provides support notation for the Chapter 11 matrix-normal appendix.
The Wishart law is represented as the push-forward law of a matrix quadratic
form. The law lemmas include non-tautological push-forward bridges for
cross-products, inverse-Wishart scalar forms, and Hotelling's statistic. The
canonical iid-normal endpoints derive the Wishart, inverse-Wishart, and scaled
Hotelling laws stated in Theorems 11.10--11.12.
-/

open MeasureTheory ProbabilityTheory
open scoped Matrix Matrix.Norms.Elementwise MatrixOrder

namespace HansenEconometrics

open Matrix

@[reducible]
private noncomputable def matrixBorelMeasurableSpaceInst
    {ι κ : Type*} [Fintype ι] [Fintype κ] :
    MeasurableSpace (Matrix ι κ ℝ) :=
  matrixBorelMeasurableSpace ι κ

attribute [local instance] matrixBorelMeasurableSpaceInst

private lemma matrixBorelSpaceInst
    {ι κ : Type*} [Fintype ι] [Fintype κ] :
    @BorelSpace (Matrix ι κ ℝ) _ (matrixBorelMeasurableSpaceInst (ι := ι) (κ := κ)) :=
  matrixBorelSpace ι κ

attribute [local instance] matrixBorelSpaceInst

private theorem matrixBorelMeasurableSpaceInst_le_pi
    {ι κ : Type*} [Fintype ι] [Fintype κ] :
    matrixBorelMeasurableSpaceInst (ι := ι) (κ := κ) ≤
      (inferInstance : MeasurableSpace (ι → κ → ℝ)) := by
  have hPiBorel :
      @BorelSpace (ι → κ → ℝ) _
        (inferInstance : MeasurableSpace (ι → κ → ℝ)) :=
    inferInstance
  have hEq : (inferInstance : MeasurableSpace (ι → κ → ℝ)) =
      borel (ι → κ → ℝ) :=
    @BorelSpace.measurable_eq (ι → κ → ℝ) _
      (inferInstance : MeasurableSpace (ι → κ → ℝ)) hPiBorel
  simpa [matrixBorelMeasurableSpaceInst, matrixBorelMeasurableSpace] using
    le_of_eq hEq.symm

private theorem pi_le_matrixBorelMeasurableSpaceInst
    {ι κ : Type*} [Fintype ι] [Fintype κ] :
    (inferInstance : MeasurableSpace (ι → κ → ℝ)) ≤
      matrixBorelMeasurableSpaceInst (ι := ι) (κ := κ) := by
  have hPiBorel :
      @BorelSpace (ι → κ → ℝ) _
        (inferInstance : MeasurableSpace (ι → κ → ℝ)) :=
    inferInstance
  have hEq : (inferInstance : MeasurableSpace (ι → κ → ℝ)) =
      borel (ι → κ → ℝ) :=
    @BorelSpace.measurable_eq (ι → κ → ℝ) _
      (inferInstance : MeasurableSpace (ι → κ → ℝ)) hPiBorel
  simpa [matrixBorelMeasurableSpaceInst, matrixBorelMeasurableSpace] using
    le_of_eq hEq

variable {Ω n m : Type*}
variable [MeasurableSpace Ω] {μ : Measure Ω}
variable [Fintype n] [Fintype m] [DecidableEq n] [DecidableEq m]

/-- Matrix quadratic form `Y'Y`. -/
noncomputable def matrixCrossProduct (Y : Matrix n m ℝ) : Matrix m m ℝ :=
  Yᵀ * Y

omit [Fintype m] [DecidableEq m] [DecidableEq n] in
/-- If an `r × r` row-submatrix of a rectangular matrix is invertible, then
the full rectangular cross-product is nonsingular.

This deterministic bridge is used to reduce rectangular standard-Gaussian Gram
nonsingularity to the square determinant certificate supplied by selected rows.
-/
theorem matrixCrossProduct_nonsingular_of_square_row_submatrix_invertible
    {r : Type*} [Fintype r] [DecidableEq r]
    (X : Matrix n r ℝ) (e : r → n)
    (hsub : Nonempty (Invertible (X.submatrix e id))) :
    Nonempty (Invertible (matrixCrossProduct X)) := by
  classical
  rcases hsub with ⟨instSub⟩
  let A : Matrix r r ℝ := X.submatrix e id
  haveI : Invertible A := by
    change Invertible (X.submatrix e id)
    exact instSub
  have hA_det : A.det ≠ 0 := (Matrix.isUnit_det_of_invertible A).ne_zero
  have hAker : ∀ v : r → ℝ, A *ᵥ v = 0 → v = 0 := by
    intro v hv
    exact Matrix.eq_zero_of_mulVec_eq_zero hA_det hv
  have hXker : ∀ v : r → ℝ, matrixCrossProduct X *ᵥ v = 0 → v = 0 := by
    intro v hv
    have hmemGram : v ∈ LinearMap.ker (Xᵀ * X).mulVecLin := by
      simpa [LinearMap.mem_ker, Matrix.mulVecLin_apply, matrixCrossProduct] using hv
    have hmemX : v ∈ LinearMap.ker X.mulVecLin := by
      rw [← Matrix.ker_mulVecLin_transpose_mul_self X]
      exact hmemGram
    have hXv : X *ᵥ v = 0 := by
      simpa [LinearMap.mem_ker, Matrix.mulVecLin_apply] using hmemX
    have hAv : A *ᵥ v = 0 := by
      ext i
      simpa [A, Matrix.mulVec] using congr_fun hXv (e i)
    exact hAker v hAv
  have hdet : (matrixCrossProduct X).det ≠ 0 := by
    intro hzero
    rcases (Matrix.exists_mulVec_eq_zero_iff
        (M := matrixCrossProduct X)).mpr hzero with ⟨v, hvne, hv⟩
    exact hvne (hXker v hv)
  exact (nonempty_invertible_iff_isUnit (matrixCrossProduct X)).mpr <|
    (Matrix.isUnit_iff_isUnit_det (matrixCrossProduct X)).mpr
      (isUnit_iff_ne_zero.mpr hdet)

/-- Wishart law generated by a matrix-valued sampling law. -/
noncomputable def wishartMatrixLaw
    (Ylaw : Measure (Matrix n m ℝ)) : Measure (Matrix m m ℝ) :=
  Ylaw.map matrixCrossProduct

instance wishartMatrixLaw_sfinite
    (Ylaw : Measure (Matrix n m ℝ)) [SFinite Ylaw] :
    SFinite (wishartMatrixLaw Ylaw) := by
  rw [wishartMatrixLaw]
  infer_instance

/-- Scaled Wishart law, used for covariance matrices such as `(n-1)⁻¹ W`. -/
noncomputable def scaledWishartMatrixLaw
    (c : ℝ) (Ylaw : Measure (Matrix n m ℝ)) : Measure (Matrix m m ℝ) :=
  (wishartMatrixLaw Ylaw).map fun W => c • W

instance scaledWishartMatrixLaw_sfinite
    (c : ℝ) (Ylaw : Measure (Matrix n m ℝ)) [SFinite Ylaw] :
    SFinite (scaledWishartMatrixLaw c Ylaw) := by
  rw [scaledWishartMatrixLaw]
  infer_instance

/-- Row law for a vector-valued Gaussian observation, represented on plain
functions `m → ℝ` rather than `EuclideanSpace ℝ m`. -/
noncomputable def rowGaussianLaw
    (mean : m → ℝ) (Sigma : Matrix m m ℝ) : Measure (m → ℝ) :=
  (multivariateGaussian (WithLp.toLp 2 mean) Sigma).map
    fun z : EuclideanSpace ℝ m => z.ofLp

instance rowGaussianLaw_isProbabilityMeasure
    (mean : m → ℝ) (Sigma : Matrix m m ℝ) :
    IsProbabilityMeasure (rowGaussianLaw mean Sigma) := by
  rw [rowGaussianLaw]
  exact Measure.isProbabilityMeasure_map (by fun_prop)

omit [DecidableEq m] in
/-- Continuous linear map underlying the `rowGaussianLaw` representation. -/
private noncomputable def euclideanSpaceToFunCLM :
    EuclideanSpace ℝ m →L[ℝ] (m → ℝ) :=
  (PiLp.continuousLinearEquiv 2 ℝ (fun _ : m => ℝ)).toContinuousLinearMap

omit [DecidableEq m] in
@[simp]
private theorem euclideanSpaceToFunCLM_apply (z : EuclideanSpace ℝ m) :
    euclideanSpaceToFunCLM (m := m) z = z.ofLp := by
  rfl

/-- The Hansen row-normal law is Gaussian as a measure on coordinate functions. -/
instance rowGaussianLaw_isGaussian
    (mean : m → ℝ) (Sigma : Matrix m m ℝ) :
    IsGaussian (rowGaussianLaw mean Sigma) := by
  change IsGaussian ((multivariateGaussian (WithLp.toLp 2 mean) Sigma).map
    (euclideanSpaceToFunCLM (m := m)))
  exact isGaussian_map_of_measurable
    (μ := multivariateGaussian (WithLp.toLp 2 mean) Sigma)
    (L := euclideanSpaceToFunCLM (m := m)) (by fun_prop)

/-- Coordinate means of Hansen's row-normal law. -/
theorem rowGaussianLaw_integral_eval
    (mean : m → ℝ) (Sigma : Matrix m m ℝ) (a : m) :
    ∫ x : m → ℝ, x a ∂rowGaussianLaw mean Sigma = mean a := by
  have hphi : AEMeasurable (fun z : EuclideanSpace ℝ m => z.ofLp)
      (multivariateGaussian (WithLp.toLp 2 mean) Sigma) := by
    fun_prop
  have heval : AEStronglyMeasurable (fun x : m → ℝ => x a)
      (rowGaussianLaw mean Sigma) :=
    (measurable_pi_apply (X := fun _ : m => ℝ) a).aestronglyMeasurable
  rw [rowGaussianLaw]
  rw [integral_map hphi]
  · change ∫ z : EuclideanSpace ℝ m, z.ofLp a
        ∂multivariateGaussian (WithLp.toLp 2 mean) Sigma = mean a
    have h := (EuclideanSpace.proj a).integral_comp_comm
      (μ := multivariateGaussian (WithLp.toLp 2 mean) Sigma) IsGaussian.integrable_id
    simpa [EuclideanSpace.proj] using h
  · simpa [rowGaussianLaw] using heval

/-- Coordinate covariances of Hansen's row-normal law. -/
theorem rowGaussianLaw_covariance_eval
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (a b : m) :
    cov[fun x : m → ℝ => x a, fun x : m → ℝ => x b;
      rowGaussianLaw mean Sigma] = Sigma a b := by
  let base := multivariateGaussian (WithLp.toLp 2 mean) Sigma
  have hphi : AEMeasurable (fun z : EuclideanSpace ℝ m => z.ofLp) base := by
    fun_prop
  let hlaw : HasLaw (fun z : EuclideanSpace ℝ m => z.ofLp)
      (rowGaussianLaw mean Sigma) base :=
    ⟨hphi, by rfl⟩
  have heval_a : AEMeasurable (fun x : m → ℝ => x a)
      (rowGaussianLaw mean Sigma) :=
    (measurable_pi_apply (X := fun _ : m => ℝ) a).aemeasurable
  have heval_b : AEMeasurable (fun x : m → ℝ => x b)
      (rowGaussianLaw mean Sigma) :=
    (measurable_pi_apply (X := fun _ : m => ℝ) b).aemeasurable
  have hcov := hlaw.covariance_fun_comp heval_a heval_b
  rw [← hcov]
  exact covariance_eval_multivariateGaussian hSigma a b

omit [Fintype n] [DecidableEq n] in
/-- Linear image of a Hansen row-normal law under a column-coordinate map.

This is the row-level transport used by the matrix-normal whitening step:
if `x ∼ N(mean, Σ)`, then `Tᵀx ∼ N(Tᵀmean, TᵀΣT)`. -/
theorem rowGaussianLaw_transpose_mulVec_map
    {q : Type*} [Fintype q] [DecidableEq q]
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (T : Matrix m q ℝ) :
    (rowGaussianLaw mean Sigma).map (fun x : m → ℝ => Tᵀ *ᵥ x) =
      rowGaussianLaw (Tᵀ *ᵥ mean) (Tᵀ * Sigma * T) := by
  classical
  let base : Measure (EuclideanSpace ℝ m) :=
    multivariateGaussian (WithLp.toLp 2 mean) Sigma
  let L : EuclideanSpace ℝ m →L[ℝ] EuclideanSpace ℝ q :=
    matrixContinuousLinearMap Tᵀ
  have hleft :
      (rowGaussianLaw mean Sigma).map (fun x : m → ℝ => Tᵀ *ᵥ x) =
        base.map (fun z : EuclideanSpace ℝ m => (L z).ofLp) := by
    rw [rowGaussianLaw]
    rw [Measure.map_map (by fun_prop) (by fun_prop)]
    rfl
  have hright :
      rowGaussianLaw (Tᵀ *ᵥ mean) (Tᵀ * Sigma * T) =
        (multivariateGaussian (L (WithLp.toLp 2 mean)) (Tᵀ * Sigma * T)).map
          (fun z : EuclideanSpace ℝ q => z.ofLp) := by
    rw [rowGaussianLaw]
    rfl
  rw [hleft, hright]
  calc
    base.map (fun z : EuclideanSpace ℝ m => (L z).ofLp)
        = (base.map L).map (fun z : EuclideanSpace ℝ q => z.ofLp) := by
            rw [Measure.map_map (by fun_prop) (by fun_prop)]
            rfl
    _ = (multivariateGaussian (L (WithLp.toLp 2 mean)) (Tᵀ * Sigma * T)).map
          (fun z : EuclideanSpace ℝ q => z.ofLp) := by
            rw [map_matrix_multivariateGaussian hSigma Tᵀ]
            simp [L, Matrix.conjTranspose_eq_transpose_of_trivial]

/-- Euclidean-space Gaussian law from coordinate means and covariances.

This is a reusable bridge from Mathlib's `HasGaussianLaw` API to the
Hansen-facing multivariate normal notation. -/
theorem hasLaw_multivariateGaussian_of_hasGaussianLaw_eval
    [IsProbabilityMeasure μ]
    (Z : Ω → m → ℝ) (mean : m → ℝ)
    {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hG : HasGaussianLaw Z μ)
    (hmean : ∀ a : m, ∫ ω, Z ω a ∂μ = mean a)
    (hcov : ∀ a b : m, cov[fun ω => Z ω a, fun ω => Z ω b; μ] = Sigma a b) :
    HasLaw (fun ω => WithLp.toLp 2 (Z ω))
      (multivariateGaussian (WithLp.toLp 2 mean) Sigma) μ := by
  let L : (m → ℝ) →L[ℝ] EuclideanSpace ℝ m :=
    (PiLp.continuousLinearEquiv 2 ℝ (fun _ : m => ℝ)).symm.toContinuousLinearMap
  have hZlpG :
      HasGaussianLaw (fun ω => WithLp.toLp 2 (Z ω) : Ω → EuclideanSpace ℝ m) μ := by
    simpa [L] using hG.map_fun L
  refine ⟨hZlpG.aemeasurable, ?_⟩
  haveI : IsGaussian
      (μ.map fun ω => WithLp.toLp 2 (Z ω) : Measure (EuclideanSpace ℝ m)) :=
    hZlpG.isGaussian_map
  apply IsGaussian.ext
  · ext a
    have hEval : AEStronglyMeasurable (fun x : EuclideanSpace ℝ m => x.ofLp a)
        (μ.map fun ω => WithLp.toLp 2 (Z ω)) := by
      fun_prop
    have hleft_proj := (EuclideanSpace.proj a).integral_comp_comm
      (μ := μ.map fun ω => WithLp.toLp 2 (Z ω)) IsGaussian.integrable_id
    have hleft :
        ((∫ x, x ∂μ.map fun ω => WithLp.toLp 2 (Z ω)).ofLp a) =
          ∫ x : EuclideanSpace ℝ m, x.ofLp a
            ∂μ.map fun ω => WithLp.toLp 2 (Z ω) := by
      simpa [EuclideanSpace.proj] using hleft_proj.symm
    calc
      ((∫ x : EuclideanSpace ℝ m, id x
          ∂μ.map fun ω => WithLp.toLp 2 (Z ω)).ofLp a)
          = ∫ x : EuclideanSpace ℝ m, x.ofLp a
              ∂μ.map fun ω => WithLp.toLp 2 (Z ω) := by
              simpa [id] using hleft
      _ = ∫ ω, Z ω a ∂μ := by
              rw [integral_map hZlpG.aemeasurable hEval]
      _ = mean a := hmean a
      _ = ((∫ x : EuclideanSpace ℝ m, id x
              ∂multivariateGaussian (WithLp.toLp 2 mean) Sigma).ofLp a) := by
              simp [integral_id_multivariateGaussian]
  · rw [← ContinuousLinearMap.toBilinForm_inj]
    refine LinearMap.BilinForm.ext_basis
      (EuclideanSpace.basisFun m ℝ).toBasis fun a b => ?_
    rw [ContinuousLinearMap.toBilinForm_apply, ContinuousLinearMap.toBilinForm_apply]
    rw [covarianceBilin_apply_eq_cov IsGaussian.memLp_two_id,
      covarianceBilin_apply_eq_cov IsGaussian.memLp_two_id]
    have hinner_left :
        (fun u : EuclideanSpace ℝ m =>
            inner ℝ ((EuclideanSpace.basisFun m ℝ).toBasis a) u) =
          fun u => u.ofLp a := by
      ext u
      exact EuclideanSpace.basisFun_inner m ℝ u a
    have hinner_right :
        (fun u : EuclideanSpace ℝ m =>
            inner ℝ ((EuclideanSpace.basisFun m ℝ).toBasis b) u) =
          fun u => u.ofLp b := by
      ext u
      exact EuclideanSpace.basisFun_inner m ℝ u b
    rw [hinner_left, hinner_right]
    have hEvalA : AEStronglyMeasurable (fun x : EuclideanSpace ℝ m => x.ofLp a)
        (μ.map fun ω => WithLp.toLp 2 (Z ω)) := by
      fun_prop
    have hEvalB : AEStronglyMeasurable (fun x : EuclideanSpace ℝ m => x.ofLp b)
        (μ.map fun ω => WithLp.toLp 2 (Z ω)) := by
      fun_prop
    rw [covariance_map hEvalA hEvalB hZlpG.aemeasurable]
    change cov[fun ω => Z ω a, fun ω => Z ω b; μ] =
      cov[fun u : EuclideanSpace ℝ m => u.ofLp a,
          fun u : EuclideanSpace ℝ m => u.ofLp b;
          multivariateGaussian (WithLp.toLp 2 mean) Sigma]
    rw [hcov a b]
    rw [covariance_eval_multivariateGaussian hSigma]

/-- Function-coordinate row-normal law from Gaussian coordinate moments. -/
theorem hasLaw_rowGaussianLaw_of_hasGaussianLaw_eval
    [IsProbabilityMeasure μ]
    (Z : Ω → m → ℝ) (mean : m → ℝ)
    {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hG : HasGaussianLaw Z μ)
    (hmean : ∀ a : m, ∫ ω, Z ω a ∂μ = mean a)
    (hcov : ∀ a b : m, cov[fun ω => Z ω a, fun ω => Z ω b; μ] = Sigma a b) :
    HasLaw Z (rowGaussianLaw mean Sigma) μ := by
  have hZlp := hasLaw_multivariateGaussian_of_hasGaussianLaw_eval
    (Z := Z) (mean := mean) hSigma hG hmean hcov
  let hOfLp : HasLaw (fun z : EuclideanSpace ℝ m => z.ofLp)
      (rowGaussianLaw mean Sigma)
      (multivariateGaussian (WithLp.toLp 2 mean) Sigma) :=
    ⟨by fun_prop, rfl⟩
  simpa [Function.comp_def] using hOfLp.comp hZlp

/-- Product law for iid Gaussian rows of a random matrix. This is the
Hansen-facing matrix-normal sampling law used by the Wishart surface. -/
noncomputable def iidMatrixGaussianLaw
    (mean : m → ℝ) (Sigma : Matrix m m ℝ) : Measure (Matrix n m ℝ) :=
  ((Measure.pi fun _ : n => rowGaussianLaw mean Sigma) : Measure (n → m → ℝ)).map
    fun Y : n → m → ℝ => (Y : Matrix n m ℝ)

instance iidMatrixGaussianLaw_sfinite
    (mean : m → ℝ) (Sigma : Matrix m m ℝ) :
    SFinite (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma) := by
  rw [iidMatrixGaussianLaw]
  infer_instance

omit [Fintype m] [DecidableEq m] [DecidableEq n] in
/-- Almost-sure rectangular Gram nonsingularity from an almost-sure
invertible selected square row block.

This packages `matrixCrossProduct_nonsingular_of_square_row_submatrix_invertible`
at the iid matrix-Gaussian law layer. The remaining stochastic primitive is the
square determinant certificate for the selected rows. -/
theorem iidMatrixGaussianLaw_crossProduct_nonsingular_ae_of_square_row_submatrix_invertible
    {r : Type*} [Fintype r] [DecidableEq r]
    (mean : r → ℝ) (Sigma : Matrix r r ℝ) (e : r → n)
    (hsub : ∀ᵐ X ∂iidMatrixGaussianLaw (n := n) (m := r) mean Sigma,
      Nonempty (Invertible (X.submatrix e id))) :
    ∀ᵐ X ∂iidMatrixGaussianLaw (n := n) (m := r) mean Sigma,
      Nonempty (Invertible (matrixCrossProduct X)) := by
  filter_upwards [hsub] with X hX
  exact matrixCrossProduct_nonsingular_of_square_row_submatrix_invertible X e hX

omit [Fintype m] [DecidableEq m] [DecidableEq n] in
private theorem matrixCrossProduct_nonsingular_measurable
    {r : Type*} [Fintype r] [DecidableEq r] :
    Measurable
      (fun X : Matrix n r ℝ => Nonempty (Invertible (matrixCrossProduct X))) := by
  simp only [nonempty_invertible_iff_isUnit, Matrix.isUnit_iff_isUnit_det,
    isUnit_iff_ne_zero]
  have hcross :
      Continuous (fun X : Matrix n r ℝ => matrixCrossProduct X) := by
    change Continuous (fun X : Matrix n r ℝ => Xᵀ * X)
    fun_prop
  have hdet :
      Measurable (fun X : Matrix n r ℝ => (matrixCrossProduct X).det) :=
    (Continuous.matrix_det hcross).measurable
  exact measurableSet_setOf.1 <| by
    rw [show {X : Matrix n r ℝ | (matrixCrossProduct X).det ≠ 0} =
        (fun X : Matrix n r ℝ => (matrixCrossProduct X).det) ⁻¹'
          ({0}ᶜ : Set ℝ) by
        ext X
        simp]
    exact hdet (measurableSet_singleton (0 : ℝ)).compl

omit [DecidableEq n] in
/-- Column-coordinate image of Hansen's iid matrix-normal law.

This is the primitive matrix-Gaussian transport used by the Wishart congruence
layer: right-multiplying the sample matrix by `T` sends iid
`N(mean, Σ)` rows to iid `N(Tᵀmean, TᵀΣT)` rows. -/
theorem iidMatrixGaussianLaw_columnMap
    {q : Type*} [Fintype q] [DecidableEq q]
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (T : Matrix m q ℝ) :
    (iidMatrixGaussianLaw (n := n) (m := m) mean Sigma).map
        (fun Y : Matrix n m ℝ => Y * T) =
      iidMatrixGaussianLaw (n := n) (m := q) (Tᵀ *ᵥ mean) (Tᵀ * Sigma * T) := by
  classical
  let rowLaw : Measure (m → ℝ) := rowGaussianLaw mean Sigma
  let targetRowLaw : Measure (q → ℝ) :=
    rowGaussianLaw (Tᵀ *ᵥ mean) (Tᵀ * Sigma * T)
  let piLaw : Measure (n → m → ℝ) := Measure.pi fun _ : n => rowLaw
  let targetPiLaw : Measure (n → q → ℝ) := Measure.pi fun _ : n => targetRowLaw
  let rowMap : (n → m → ℝ) → n → q → ℝ := fun Y i => Tᵀ *ᵥ Y i
  have hcoord : rowLaw.map (fun x : m → ℝ => Tᵀ *ᵥ x) = targetRowLaw := by
    simpa [rowLaw, targetRowLaw] using
      rowGaussianLaw_transpose_mulVec_map (mean := mean) hSigma T
  have hrowMap_meas : Measurable rowMap := by
    dsimp [rowMap]
    fun_prop
  have hpi : piLaw.map rowMap = targetPiLaw := by
    dsimp [piLaw, targetPiLaw, rowMap]
    have hraw := Measure.pi_map_pi
      (μ := fun _ : n => rowLaw)
      (f := fun _ : n => fun x : m → ℝ => Tᵀ *ᵥ x)
      (fun _ => (by fun_prop : Measurable (fun x : m → ℝ => Tᵀ *ᵥ x)).aemeasurable)
    simpa [hcoord] using hraw
  have hsource_le :
      matrixBorelMeasurableSpaceInst (ι := n) (κ := m) ≤
        (inferInstance : MeasurableSpace (n → m → ℝ)) :=
    matrixBorelMeasurableSpaceInst_le_pi (ι := n) (κ := m)
  have htarget_le :
      matrixBorelMeasurableSpaceInst (ι := n) (κ := q) ≤
        (inferInstance : MeasurableSpace (n → q → ℝ)) :=
    matrixBorelMeasurableSpaceInst_le_pi (ι := n) (κ := q)
  have hcast :
      @AEMeasurable (n → m → ℝ) (Matrix n m ℝ)
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := m))
        (inferInstance : MeasurableSpace (n → m → ℝ))
        (fun Y : n → m → ℝ => (Y : Matrix n m ℝ)) piLaw := by
    change @AEMeasurable (n → m → ℝ) (n → m → ℝ)
      (matrixBorelMeasurableSpaceInst (ι := n) (κ := m))
      (inferInstance : MeasurableSpace (n → m → ℝ)) id piLaw
    exact aemeasurable_id'' piLaw hsource_le
  have hmul_meas :
      @Measurable (Matrix n m ℝ) (Matrix n q ℝ)
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := m))
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
        (fun Y : Matrix n m ℝ => Y * T) := by
    fun_prop
  have htarget_cast :
      @AEMeasurable (n → q → ℝ) (Matrix n q ℝ)
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
        (inferInstance : MeasurableSpace (n → q → ℝ))
        (fun X : n → q → ℝ => (X : Matrix n q ℝ))
        (@Measure.map (n → m → ℝ) (n → q → ℝ)
          (inferInstance : MeasurableSpace (n → m → ℝ))
          (inferInstance : MeasurableSpace (n → q → ℝ)) rowMap piLaw) := by
    change @AEMeasurable (n → q → ℝ) (n → q → ℝ)
      (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
      (inferInstance : MeasurableSpace (n → q → ℝ)) id
      (@Measure.map (n → m → ℝ) (n → q → ℝ)
        (inferInstance : MeasurableSpace (n → m → ℝ))
        (inferInstance : MeasurableSpace (n → q → ℝ)) rowMap piLaw)
    exact aemeasurable_id''
      (@Measure.map (n → m → ℝ) (n → q → ℝ)
        (inferInstance : MeasurableSpace (n → m → ℝ))
        (inferInstance : MeasurableSpace (n → q → ℝ)) rowMap piLaw) htarget_le
  change
    @Measure.map (Matrix n m ℝ) (Matrix n q ℝ)
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := m))
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
        (fun Y : Matrix n m ℝ => Y * T)
        (@Measure.map (n → m → ℝ) (Matrix n m ℝ)
          (inferInstance : MeasurableSpace (n → m → ℝ))
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := m))
          (fun Y : n → m → ℝ => (Y : Matrix n m ℝ)) piLaw) =
      @Measure.map (n → q → ℝ) (Matrix n q ℝ)
        (inferInstance : MeasurableSpace (n → q → ℝ))
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
        (fun X : n → q → ℝ => (X : Matrix n q ℝ)) targetPiLaw
  rw [AEMeasurable.map_map_of_aemeasurable
    (μ := piLaw)
    (f := fun Y : n → m → ℝ => (Y : Matrix n m ℝ))
    (g := fun Y : Matrix n m ℝ => Y * T)
    hmul_meas.aemeasurable hcast]
  have hcomp :
      @Measure.map (n → q → ℝ) (Matrix n q ℝ)
          (inferInstance : MeasurableSpace (n → q → ℝ))
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
          (fun X : n → q → ℝ => (X : Matrix n q ℝ))
          (@Measure.map (n → m → ℝ) (n → q → ℝ)
            (inferInstance : MeasurableSpace (n → m → ℝ))
            (inferInstance : MeasurableSpace (n → q → ℝ)) rowMap piLaw) =
        @Measure.map (n → m → ℝ) (Matrix n q ℝ)
          (inferInstance : MeasurableSpace (n → m → ℝ))
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
          (fun Y : n → m → ℝ => (rowMap Y : Matrix n q ℝ)) piLaw := by
    exact @AEMeasurable.map_map_of_aemeasurable
      (n → m → ℝ) (n → q → ℝ) (Matrix n q ℝ)
      (inferInstance : MeasurableSpace (n → m → ℝ))
      (inferInstance : MeasurableSpace (n → q → ℝ))
      (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
      piLaw
      (fun X : n → q → ℝ => (X : Matrix n q ℝ))
      rowMap
      htarget_cast hrowMap_meas.aemeasurable
  calc
    @Measure.map (n → m → ℝ) (Matrix n q ℝ)
        (inferInstance : MeasurableSpace (n → m → ℝ))
        (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
        ((fun Y : Matrix n m ℝ => Y * T) ∘
          fun Y : n → m → ℝ => (Y : Matrix n m ℝ)) piLaw
        = @Measure.map (n → m → ℝ) (Matrix n q ℝ)
            (inferInstance : MeasurableSpace (n → m → ℝ))
            (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
            (fun Y : n → m → ℝ => (rowMap Y : Matrix n q ℝ)) piLaw := by
            refine Measure.map_congr ?_
            filter_upwards with Y
            ext i j
            simp [rowMap, Matrix.mul_apply, Matrix.mulVec, dotProduct, mul_comm]
    _ = @Measure.map (n → q → ℝ) (Matrix n q ℝ)
          (inferInstance : MeasurableSpace (n → q → ℝ))
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
          (fun X : n → q → ℝ => (X : Matrix n q ℝ)) (piLaw.map rowMap) := hcomp.symm
    _ = @Measure.map (n → q → ℝ) (Matrix n q ℝ)
          (inferInstance : MeasurableSpace (n → q → ℝ))
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := q))
          (fun X : n → q → ℝ => (X : Matrix n q ℝ)) targetPiLaw := by
            rw [hpi]

