    F ⟂ᵢ[ν.map T] G := by
  have hFG : AEMeasurable (fun x : δ => (F x, G x)) (ν.map T) :=
    hF.prodMk hG
  have hFcomp : AEMeasurable (F ∘ T) ν :=
    hF.comp_aemeasurable hT
  have hGcomp : AEMeasurable (G ∘ T) ν :=
    hG.comp_aemeasurable hT
  rw [indepFun_iff_map_prod_eq_prod_map_map hF hG]
  rw [AEMeasurable.map_map_of_aemeasurable hFG hT]
  rw [AEMeasurable.map_map_of_aemeasurable hF hT]
  rw [AEMeasurable.map_map_of_aemeasurable hG hT]
  exact (indepFun_iff_map_prod_eq_prod_map_map hFcomp hGcomp).1 hInd

