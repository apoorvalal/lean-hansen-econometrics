`W` is nonsingular.  This is the deterministic part needed to derive original
Wishart nonsingularity from the standardized Wishart law in Theorem 11.11. -/
theorem isUnit_det_of_congr_isUnit_det_rect
    {q : Type*} [Fintype q] [DecidableEq q]
    (W : Matrix m m ℝ) (T : Matrix m q ℝ) (S : Matrix q m ℝ)
    (hST : S * T = 1) (hTS : T * S = 1)
    (hTW : IsUnit (Tᵀ * W * T).det) :
    IsUnit W.det := by
  classical
  let A : Matrix q q ℝ := Tᵀ * W * T
  have _hST_tr : Tᵀ * Sᵀ = 1 := by
    rw [← Matrix.transpose_mul, hST, Matrix.transpose_one]
  have hTS_tr : Sᵀ * Tᵀ = 1 := by
    rw [← Matrix.transpose_mul, hTS, Matrix.transpose_one]
  have hSA : Sᵀ * A = W * T := by
    calc
      Sᵀ * A = Sᵀ * (Tᵀ * W * T) := rfl
      _ = (Sᵀ * Tᵀ) * W * T := by simp [Matrix.mul_assoc]
      _ = W * T := by rw [hTS_tr, Matrix.one_mul]
  have hright : W * (T * A⁻¹ * Tᵀ) = 1 := by
    calc
      W * (T * A⁻¹ * Tᵀ) = (W * T) * A⁻¹ * Tᵀ := by
        simp [Matrix.mul_assoc]
      _ = (Sᵀ * A) * A⁻¹ * Tᵀ := by rw [hSA]
      _ = Sᵀ * (A * A⁻¹) * Tᵀ := by simp [Matrix.mul_assoc]
      _ = Sᵀ * (1 : Matrix q q ℝ) * Tᵀ := by
        rw [Matrix.mul_nonsing_inv A hTW]
      _ = Sᵀ * Tᵀ := by rw [Matrix.mul_one]
      _ = 1 := hTS_tr
  exact Matrix.isUnit_det_of_right_inverse
    (A := W) (B := T * A⁻¹ * Tᵀ) hright

