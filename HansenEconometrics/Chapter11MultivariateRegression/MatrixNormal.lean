/-- Scalar coordinates of iid normal rows are square-integrable. -/
theorem iidNormalRows_memLp_eval
    [IsProbabilityMeasure μ] (Y : Ω → Matrix n m ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (i : n) (a : m) :
    MemLp (fun ω => Y ω i a) 2 μ := by
  have hG : HasGaussianLaw (fun ω => Y ω i) μ := (hrow i).hasGaussianLaw
  have hEval := hG.map_fun
    (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : m => ℝ) a)
  simpa using hEval.memLp_two

