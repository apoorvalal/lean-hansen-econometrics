/-- Residual-maker projection for nuisance columns, using the repo's totalized
matrix inverse convention. -/
noncomputable def gaussianResidualProjection
    {r : Type*} [Fintype r] [DecidableEq r]
    (X : Matrix n r ℝ) : Matrix n n ℝ :=
  1 - X * ((Xᵀ * X)⁻¹) * Xᵀ

