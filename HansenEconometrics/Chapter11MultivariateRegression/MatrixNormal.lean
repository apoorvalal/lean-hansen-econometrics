/-- Deterministic Hotelling `T²` ratio algebra for Hansen Theorem 11.12.

When `S = (n-1)⁻¹ W` and the displayed real denominators are nonzero,
Hansen's statistic equals the scaled ratio of the mean chi-square component
and the inverse-Wishart component. -/
theorem hotellingT2Sample_eq_hansen_scaled_ratio_of_components
    (Y : n → m → ℝ) (μ0 : m → ℝ) (Sigma W : Matrix m m ℝ)
    (hS : sampleCovarianceMatrix Y =
      ((Fintype.card n - 1 : ℝ)⁻¹) • W)
    (hcard_le : Fintype.card m ≤ Fintype.card n)
    (hm_ne : (Fintype.card m : ℝ) ≠ 0)
    (hν_ne : (Fintype.card n : ℝ) - (Fintype.card m : ℝ) ≠ 0)
    (hA_ne : (sampleMeanMatrix Y - μ0) ⬝ᵥ
        (Sigma⁻¹ *ᵥ (sampleMeanMatrix Y - μ0)) ≠ 0)
    (hB_ne : (sampleMeanMatrix Y - μ0) ⬝ᵥ
        (W⁻¹ *ᵥ (sampleMeanMatrix Y - μ0)) ≠ 0) :
    hotellingT2Sample Y μ0 =
      hotellingT2HansenScale (n := n) (m := m) *
        (((hotellingMeanChiSqComponent (n := n) (m := m) Y μ0 Sigma) /
            (Fintype.card m : ℝ)) /
          ((hotellingInverseWishartChiSqComponent
              (n := n) (m := m) Y μ0 Sigma W) /
            ((Fintype.card n - Fintype.card m : ℕ) : ℝ))) := by
  classical
  let N : ℝ := Fintype.card n
  let M : ℝ := Fintype.card m
  let d : m → ℝ := sampleMeanMatrix Y - μ0
  let A : ℝ := d ⬝ᵥ (Sigma⁻¹ *ᵥ d)
  let B : ℝ := d ⬝ᵥ (W⁻¹ *ᵥ d)
  have hν_cast : ((Fintype.card n - Fintype.card m : ℕ) : ℝ) = N - M := by
    dsimp [N, M]
    exact Nat.cast_sub hcard_le
  have hA : A ≠ 0 := by simpa [A, d] using hA_ne
  have hB : B ≠ 0 := by simpa [B, d] using hB_ne
  have hM : M ≠ 0 := by simpa [M] using hm_ne
  have hD : N - M ≠ 0 := by simpa [N, M] using hν_ne
  have hT2 : hotellingT2Sample Y μ0 = N * (N - 1) * B := by
    calc
      hotellingT2Sample Y μ0
          = N * (d ⬝ᵥ ((sampleCovarianceMatrix Y)⁻¹ *ᵥ d)) := by
              simp [hotellingT2Sample, hotellingT2, N, d]
      _ = N * (d ⬝ᵥ ((((N - 1)⁻¹) • W)⁻¹ *ᵥ d)) := by
              rw [hS]
      _ = N * (d ⬝ᵥ (((((N - 1)⁻¹)⁻¹) • W⁻¹) *ᵥ d)) := by
              rw [nonsingInv_smul]
      _ = N * (d ⬝ᵥ ((N - 1) • (W⁻¹ *ᵥ d))) := by
              simp [Matrix.smul_mulVec]
      _ = N * ((N - 1) * B) := by
              simp [B, dotProduct_smul, smul_eq_mul]
      _ = N * (N - 1) * B := by ring
  calc
    hotellingT2Sample Y μ0 = N * (N - 1) * B := hT2
    _ = hotellingT2HansenScale (n := n) (m := m) *
        (((hotellingMeanChiSqComponent (n := n) (m := m) Y μ0 Sigma) /
            (Fintype.card m : ℝ)) /
          ((hotellingInverseWishartChiSqComponent
              (n := n) (m := m) Y μ0 Sigma W) /
            ((Fintype.card n - Fintype.card m : ℕ) : ℝ))) := by
        have hAlg := hotelling_ratio_algebra N M A B hM hD hA hB
        simpa [hotellingT2HansenScale, hotellingMeanChiSqComponent,
          hotellingInverseWishartChiSqComponent, inverseWishartScaledLinearForm,
          inverseWishartLinearForm, N, M, A, B, d, hν_cast] using hAlg

