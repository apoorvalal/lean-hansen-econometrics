    _ = (Ylaw.map Ymap).map (matrixCrossProduct (n := n) (m := q)) := by
            simpa [Function.comp_def] using
              (AEMeasurable.map_map_of_aemeasurable
              (μ := Ylaw) (f := Ymap)
              (g := matrixCrossProduct (n := n) (m := q))
