/-- Fixed row contrasts of iid Gaussian rows are jointly Gaussian.

This is the Gaussian-law half of the centered-contrast push-forward for Hansen
Theorem 11.10. The separate row-law and zero cross-covariance identifications
are what remain to turn this into the iid matrix-normal law. -/
theorem sampleContrastRows_hasGaussianLaw_of_iid_normal_rows
    [IsProbabilityMeasure μ]
    {df : Type*} [Fintype df]
    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ) :
    HasGaussianLaw
      (fun ω r a => sampleContrastRows (n := n) C (Y ω) r a) μ := by
  have hrowG :
      ∀ i : n, HasGaussianLaw (fun ω => Y ω i) μ :=
    fun i => (hrow i).hasGaussianLaw
  have hjoint :
      HasGaussianLaw (fun ω i => Y ω i) μ :=
    hInd.hasGaussianLaw hrowG
  have hmap := hjoint.map_fun (contrastRowsCLM (n := n) (m := m) C)
  simpa [contrastRowsCLM_apply] using hmap

