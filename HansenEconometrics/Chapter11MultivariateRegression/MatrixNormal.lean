/-- Column reindexing preserves Hansen's iid standard Gaussian matrix law. -/
theorem iidMatrixGaussianLaw_standard_columnReindex_map
    {r s : Type*} [Fintype r] [DecidableEq r] [Fintype s] [DecidableEq s]
    (e : r ≃ s) :
    (iidMatrixGaussianLaw (n := n) (m := r)
        (0 : r → ℝ) (1 : Matrix r r ℝ)).map
        (fun Y : Matrix n r ℝ => Y.submatrix id e.symm) =
      iidMatrixGaussianLaw (n := n) (m := s)
        (0 : s → ℝ) (1 : Matrix s s ℝ) := by
  classical
  let T : Matrix r s ℝ := (1 : Matrix s s ℝ).submatrix e id
  have hmean : Tᵀ *ᵥ (0 : r → ℝ) = (0 : s → ℝ) := by
    ext j
    simp [T, Matrix.mulVec]
  have hcov_mul :
      Tᵀ * T = (1 : Matrix s s ℝ) := by
    have hTt :
        Tᵀ = (1 : Matrix s s ℝ).submatrix id e := by
      ext i j
      by_cases hij : i = e j
      · subst i
        rfl
      · have hji : e j ≠ i := by
          exact Ne.symm hij
        simp [T, hij, hji]
    calc
      Tᵀ * T = (1 : Matrix s s ℝ).submatrix id e *
          (1 : Matrix s s ℝ).submatrix e id := by rw [hTt]
      _ = ((1 : Matrix s s ℝ) * (1 : Matrix s s ℝ)).submatrix id id := by
          rw [Matrix.submatrix_mul_equiv]
      _ = (1 : Matrix s s ℝ) := by simp
  have hcov :
      Tᵀ * (1 : Matrix r r ℝ) * T = (1 : Matrix s s ℝ) := by
    simpa using hcov_mul
  have hfun :
      (fun Y : Matrix n r ℝ => Y * T) =
        fun Y : Matrix n r ℝ => Y.submatrix id e.symm := by
    funext Y
    simpa [T] using
      (Matrix.mul_submatrix_one (α := ℝ) e (id : s → s) Y)
  have hmap := iidMatrixGaussianLaw_columnMap
    (n := n) (m := r) (q := s)
    (mean := (0 : r → ℝ))
    (Sigma := (1 : Matrix r r ℝ))
    Matrix.PosSemidef.one T
  simpa [hmean, hcov, hcov_mul, hfun] using hmap

omit [Fintype m] [DecidableEq m] [DecidableEq n] in
/-- Column reindexing preserves a standard-Gaussian Gram nonsingularity
certificate. -/
theorem iidMatrixGaussianLaw_standard_crossProduct_nonsingular_ae_of_equiv
    {r s : Type*} [Fintype r] [DecidableEq r] [Fintype s] [DecidableEq s]
    (e : r ≃ s)
    (hgram : ∀ᵐ X ∂iidMatrixGaussianLaw (n := n) (m := r)
        (0 : r → ℝ) (1 : Matrix r r ℝ),
      Nonempty (Invertible (matrixCrossProduct X))) :
    ∀ᵐ Y ∂iidMatrixGaussianLaw (n := n) (m := s)
        (0 : s → ℝ) (1 : Matrix s s ℝ),
      Nonempty (Invertible (matrixCrossProduct Y)) := by
  classical
  let f : Matrix n r ℝ → Matrix n s ℝ := fun Y => Y.submatrix id e.symm
  let rlaw : Measure (Matrix n r ℝ) :=
    iidMatrixGaussianLaw (n := n) (m := r)
      (0 : r → ℝ) (1 : Matrix r r ℝ)
  let slaw : Measure (Matrix n s ℝ) :=
    iidMatrixGaussianLaw (n := n) (m := s)
      (0 : s → ℝ) (1 : Matrix s s ℝ)
  have hf : HasLaw f slaw rlaw := by
    have hf_meas : AEMeasurable f rlaw := by
      have hsource_ge :
          (inferInstance : MeasurableSpace (n → r → ℝ)) ≤
            matrixBorelMeasurableSpaceInst (ι := n) (κ := r) :=
        pi_le_matrixBorelMeasurableSpaceInst (ι := n) (κ := r)
      have htarget_le :
          matrixBorelMeasurableSpaceInst (ι := n) (κ := s) ≤
            (inferInstance : MeasurableSpace (n → s → ℝ)) :=
        matrixBorelMeasurableSpaceInst_le_pi (ι := n) (κ := s)
      have hraw :
          @Measurable (Matrix n r ℝ) (n → s → ℝ)
            (matrixBorelMeasurableSpaceInst (ι := n) (κ := r))
            (inferInstance : MeasurableSpace (n → s → ℝ))
            (fun Y : Matrix n r ℝ => fun i : n => fun j : s => Y i (e.symm j)) := by
        refine measurable_pi_lambda _ (fun i => ?_)
        refine measurable_pi_lambda _ (fun j => ?_)
        have hcoord :
            @Measurable (n → r → ℝ) ℝ
              (inferInstance : MeasurableSpace (n → r → ℝ)) inferInstance
              (fun Y : n → r → ℝ => Y i (e.symm j)) :=
          ((continuous_apply (e.symm j) :
            Continuous (fun x : r → ℝ => x (e.symm j))).comp
            (continuous_apply i :
              Continuous (fun Y : n → r → ℝ => Y i))).measurable
        exact hcoord.mono hsource_ge le_rfl
      have hmeas :
          @Measurable (Matrix n r ℝ) (Matrix n s ℝ)
            (matrixBorelMeasurableSpaceInst (ι := n) (κ := r))
            (matrixBorelMeasurableSpaceInst (ι := n) (κ := s)) f := by
        change @Measurable (Matrix n r ℝ) (n → s → ℝ)
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := r))
          (matrixBorelMeasurableSpaceInst (ι := n) (κ := s))
          (fun Y : Matrix n r ℝ => fun i : n => fun j : s => Y i (e.symm j))
        exact hraw.mono le_rfl htarget_le
      exact hmeas.aemeasurable
    exact ⟨hf_meas, by
      simpa [rlaw, slaw, f] using
        iidMatrixGaussianLaw_standard_columnReindex_map (n := n) e⟩
  have hpre : ∀ᵐ X ∂rlaw,
      Nonempty (Invertible (matrixCrossProduct (f X))) := by
    filter_upwards [by simpa [rlaw] using hgram] with X hX
    letI : Invertible (matrixCrossProduct X) := hX.invertible
    have hcross :
        matrixCrossProduct (f X) =
          (matrixCrossProduct X).submatrix e.symm e.symm := by
      ext i j
      simp [f, matrixCrossProduct, Matrix.mul_apply]
    rw [hcross]
    exact ⟨Matrix.submatrixEquivInvertible (matrixCrossProduct X) e.symm e.symm⟩
  exact
    (hf.ae_iff
      (p := fun Y : Matrix n s ℝ =>
        Nonempty (Invertible (matrixCrossProduct Y)))
      (matrixCrossProduct_nonsingular_measurable (n := n) (r := s))).1 hpre

