/-- The sample-centering projection kills constant row vectors. -/
@[simp]
theorem sampleCenteringMatrix_mulVec_one :
    sampleCenteringMatrix (n := n) *ᵥ (fun _ : n => (1 : ℝ)) = 0 := by
  classical
  ext i
  have hcard_nat : Fintype.card n ≠ 0 := by
    letI : Nonempty n := ⟨i⟩
    exact Fintype.card_ne_zero
  have hcard : (Fintype.card n : ℝ) ≠ 0 := by
    exact_mod_cast hcard_nat
  have hsum_id : ∑ j : n, (1 : Matrix n n ℝ) i j = 1 := by
    rw [Finset.sum_eq_single i]
    · simp
    · intro b _ hb
      simp [hb.symm]
    · intro hnot
      simp at hnot
  have hsum_const :
      ∑ _ : n, (Fintype.card n : ℝ)⁻¹ =
        (Fintype.card n : ℝ) * (Fintype.card n : ℝ)⁻¹ := by
    simp [Finset.sum_const, nsmul_eq_mul]
  calc
    (sampleCenteringMatrix (n := n) *ᵥ (fun _ : n => (1 : ℝ))) i
        = ∑ j : n, ((1 : Matrix n n ℝ) i j - (Fintype.card n : ℝ)⁻¹) := by
            simp [sampleCenteringMatrix, Matrix.mulVec, dotProduct]
    _ = ∑ j : n, (1 : Matrix n n ℝ) i j -
          ∑ _ : n, (Fintype.card n : ℝ)⁻¹ := by
            rw [Finset.sum_sub_distrib]
    _ = 1 - (Fintype.card n : ℝ) * (Fintype.card n : ℝ)⁻¹ := by
            rw [hsum_id, hsum_const]
    _ = 0 := by
            rw [mul_inv_cancel₀ hcard]
            ring

