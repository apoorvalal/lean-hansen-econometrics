/-- Cross-covariance between the sample mean and a fixed contrast row. -/
theorem sampleMeanMatrix_sampleContrastRows_covariance_eval
    [IsProbabilityMeasure μ] [Nonempty n]
    {df : Type*} [Fintype df]
    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n))
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ)
    (a : m) (r : df) (b : m) :
    cov[fun ω => sampleMeanMatrix (Y ω) a,
        fun ω => sampleContrastRows (n := n) C (Y ω) r b; μ] = 0 := by
  classical
  let c : ℝ := (Fintype.card n : ℝ)⁻¹
  have hmemL : ∀ i : n, MemLp (fun ω => c * Y ω i a) 2 μ := by
    intro i
    exact (iidNormalRows_memLp_eval
      (Y := Y) (mean := mean) (Sigma := Sigma) hrow i a).const_mul c
  have hmemR : ∀ j : n, MemLp (fun ω => C r j * Y ω j b) 2 μ := by
    intro j
    exact (iidNormalRows_memLp_eval
      (Y := Y) (mean := mean) (Sigma := Sigma) hrow j b).const_mul _
  have hrow_sum :
      ∑ j : n, C r j = 0 := by
    have hzero := orthogonalContrast_mulVec_const_eq_zero_of_centering
      (C := C) hcenter (1 : ℝ)
    have hcoord := congrFun hzero r
    simpa [Matrix.mulVec, dotProduct] using hcoord
  calc
    cov[fun ω => sampleMeanMatrix (Y ω) a,
        fun ω => sampleContrastRows (n := n) C (Y ω) r b; μ]
        = cov[fun ω => ∑ i : n, c * Y ω i a,
            fun ω => ∑ j : n, C r j * Y ω j b; μ] := by
            simp [sampleMeanMatrix, sampleContrastRows, sampleRowMatrix,
              Matrix.mul_apply, c, smul_eq_mul, Finset.mul_sum]
    _ = ∑ i : n, ∑ j : n,
          cov[fun ω => c * Y ω i a, fun ω => C r j * Y ω j b; μ] := by
            rw [ProbabilityTheory.covariance_fun_sum_fun_sum hmemL hmemR]
    _ = ∑ i : n, ∑ j : n,
          c * C r j * (if i = j then Sigma a b else 0) := by
            refine Finset.sum_congr rfl ?_
            intro i _
            refine Finset.sum_congr rfl ?_
            intro j _
            rw [ProbabilityTheory.covariance_const_mul_left,
              ProbabilityTheory.covariance_const_mul_right]
            by_cases hij : i = j
            · subst j
              rw [if_pos rfl]
              rw [iidNormalRows_covariance_eval_same
                (Y := Y) (mean := mean) (hSigma := hSigma) hrow i a b]
              ring
            · rw [if_neg hij]
              rw [iidNormalRows_covariance_eval_ne
                (Y := Y) (mean := mean) (Sigma := Sigma) hrow hInd hij a b]
              ring
    _ = c * (∑ j : n, C r j) * Sigma a b := by
            calc
              ∑ i : n, ∑ j : n, c * C r j *
                  (if i = j then Sigma a b else 0)
                  = ∑ i : n, c * C r i * Sigma a b := by
                      refine Finset.sum_congr rfl ?_
                      intro i _
                      rw [Finset.sum_eq_single i]
                      · simp
                      · intro j _ hji
                        rw [if_neg (Ne.symm hji)]
                        ring
                      · intro hi
                        simp at hi
              _ = c * (∑ j : n, C r j) * Sigma a b := by
                      calc
                        ∑ i : n, c * C r i * Sigma a b
                            = (∑ i : n, c * C r i) * Sigma a b := by
                                rw [Finset.sum_mul]
                        _ = c * (∑ j : n, C r j) * Sigma a b := by
                                rw [← Finset.mul_sum]
    _ = 0 := by
            rw [hrow_sum]
            ring

/-- The sample mean is independent of any orthonormal centered Gaussian
contrast coordinate family. This is the Gaussian independence component needed
for Hansen Theorem 11.12; matrix-valued functions of the contrasts can be
obtained from this coordinate process by measurable maps. -/
theorem sampleMeanMatrix_indepFun_sampleContrastRows_flat_of_orthogonal_iid_normal_rows
    [IsProbabilityMeasure μ] [Nonempty n]
    {df : Type*} [Fintype df]
    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n))
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ) :
    IndepFun (fun ω => sampleMeanMatrix (Y ω))
      (fun (ω : Ω) (p : df × m) =>
        sampleContrastRows (n := n) C (Y ω) p.1 p.2) μ := by
  have hG := sampleMeanMatrix_sampleContrastRows_hasGaussianLaw_of_iid_normal_rows
    (Y := Y) (C := C) (mean := mean) (Sigma := Sigma) hrow hInd
  refine hG.indepFun_of_covariance_eval ?_
  intro a p
  exact sampleMeanMatrix_sampleContrastRows_covariance_eval
    (Y := Y) (C := C) (mean := mean) (hSigma := hSigma)
    hcenter hrow hInd a p.1 p.2

/-- The sample mean is independent of the centered contrast cross-product.

This lifts `sampleMeanMatrix_indepFun_sampleContrastRows_flat_of_orthogonal_iid_normal_rows`
through the measurable matrix cross-product map. -/
theorem sampleMeanMatrix_indepFun_contrastCrossProduct_of_orthogonal_iid_normal_rows
    [IsProbabilityMeasure μ] [Nonempty n]
    {df : Type*} [Fintype df]
    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) {Sigma : Matrix m m ℝ} (hSigma : Sigma.PosSemidef)
    (hcenter : Cᵀ * C = sampleCenteringMatrix (n := n))
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (hInd : iIndepFun (fun i ω => Y ω i) μ) :
    IndepFun (fun ω => sampleMeanMatrix (Y ω))
      (fun ω => matrixCrossProduct (sampleContrastRows (n := n) C (Y ω))) μ := by
  classical
  have hFlat :=
    sampleMeanMatrix_indepFun_sampleContrastRows_flat_of_orthogonal_iid_normal_rows
      (Y := Y) (C := C) (mean := mean) (hSigma := hSigma)
      hcenter hrow hInd
  let ψ : (df × m → ℝ) → Matrix m m ℝ := fun z =>
    matrixCrossProduct (n := df) (m := m) (fun r a => z (r, a))
  have hψ : Measurable ψ := by
    dsimp [ψ, matrixCrossProduct]
    fun_prop
  simpa [ψ, Function.comp_def] using
    (IndepFun.comp (φ := id) (ψ := ψ) hFlat measurable_id hψ)

