/-- The sample-centering matrix has trace `n - 1`. -/
theorem sampleCenteringMatrix_trace [Nonempty n] :
    Matrix.trace (sampleCenteringMatrix (n := n)) =
      (Fintype.card n : ℝ) - 1 := by
  classical
  have hN : (Fintype.card n : ℝ) ≠ 0 := by
    exact_mod_cast (Fintype.card_ne_zero (α := n))
  rw [sampleCenteringMatrix, Matrix.trace_sub, Matrix.trace_one]
  have hdiag :
      Matrix.trace (fun _ _ : n => (Fintype.card n : ℝ)⁻¹) = 1 := by
    rw [Matrix.trace]
    simp [Finset.sum_const, nsmul_eq_mul, hN]
  rw [hdiag]

