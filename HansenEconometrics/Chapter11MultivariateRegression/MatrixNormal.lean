/-- Mean of a fixed contrast-row coordinate. -/
theorem sampleContrastRows_integral_eval
    [IsProbabilityMeasure μ]
    {df : Type*} [Fintype df]
    (Y : Ω → Matrix n m ℝ) (C : Matrix df n ℝ)
    (mean : m → ℝ) (Sigma : Matrix m m ℝ)
    (hrow : ∀ i : n, HasLaw (fun ω => Y ω i) (rowGaussianLaw mean Sigma) μ)
    (r : df) (a : m) :
    ∫ ω, sampleContrastRows (n := n) C (Y ω) r a ∂μ =
      (C *ᵥ (fun _ : n => mean a)) r := by
  have hint : ∀ i : n, Integrable (fun ω => C r i * Y ω i a) μ := by
    intro i
    exact memLp_one_iff_integrable.mp
      (((iidNormalRows_memLp_eval
        (Y := Y) (mean := mean) (Sigma := Sigma) hrow i a).const_mul _).mono_exponent
          one_le_two)
  calc
    ∫ ω, sampleContrastRows (n := n) C (Y ω) r a ∂μ
        = ∫ ω, ∑ i : n, C r i * Y ω i a ∂μ := by
            simp [sampleContrastRows, sampleRowMatrix, Matrix.mul_apply]
    _ = ∑ i : n, ∫ ω, C r i * Y ω i a ∂μ := by
            rw [integral_finset_sum]
            intro i _
            exact hint i
    _ = ∑ i : n, C r i * mean a := by
            refine Finset.sum_congr rfl ?_
            intro i _
            rw [integral_const_mul]
            have hmean_raw := (hrow i).integral_comp
              (f := fun x : m → ℝ => x a)
              ((measurable_pi_apply (X := fun _ : m => ℝ) a).aestronglyMeasurable)
            have hmean_i : ∫ ω, Y ω i a ∂μ = mean a := by
              simpa [Function.comp_def, rowGaussianLaw_integral_eval mean Sigma a] using hmean_raw
            rw [hmean_i]
    _ = (C *ᵥ (fun _ : n => mean a)) r := by
            simp [Matrix.mulVec, dotProduct]

/-- Centered contrast rows have zero coordinate means. -/
theorem sampleContrastRows_integral_eval_zero_of_centering
    [IsProbabilityMeasure μ]
    {df : Type*} [Fintype df]
