private theorem indepFun_map_of_indepFun_comp
    {α β γ δ : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [MeasurableSpace γ] [MeasurableSpace δ] {ν : Measure α}
    [IsFiniteMeasure ν] {T : α → δ} {F : δ → β} {G : δ → γ}
    (hT : AEMeasurable T ν)
    (hF : AEMeasurable F (ν.map T))
    (hG : AEMeasurable G (ν.map T))
